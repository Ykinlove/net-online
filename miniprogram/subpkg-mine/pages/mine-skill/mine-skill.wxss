/* 技能树：文档风 / 全局 token —— 无字面色值、无粗边框、无渐变 */
.sk { padding-bottom: calc(60 * var(--u)); }
.sk-h1 { display: block; margin-bottom: calc(8 * var(--u)); }
.sk-sub { display: block; margin-bottom: calc(28 * var(--u)); }

/* 分类等级：圆形徽章 + 细线连接 + 全局进度条 */
.cat-row { display: flex; align-items: center; gap: calc(16 * var(--u)); padding: calc(18 * var(--u)) calc(4 * var(--u)); }
.cat-link { flex: none; width: calc(24 * var(--u)); }
.cat-body { flex: 1; min-width: 0; }
.cat-top { display: flex; align-items: center; justify-content: space-between; margin-bottom: calc(10 * var(--u)); }
.cat-name { font-size: calc(26 * var(--u)); font-weight: 500; color: var(--text-primary); }
.cat-n { font-size: calc(21 * var(--u)); color: var(--text-tertiary); }
.cat-lv { flex: none; font-size: calc(21 * var(--u)); font-weight: 600; color: var(--primary); }

.sk-seg { margin-bottom: calc(20 * var(--u)); }

/* 技能清单：去外框，改底部分割线 */
.skill-item { display: flex; align-items: center; gap: calc(16 * var(--u)); }
.skill-main { flex: 1; display: flex; flex-direction: column; gap: calc(6 * var(--u)); min-width: 0; }
.skill-name { font-size: calc(27 * var(--u)); font-weight: 500; color: var(--text-primary); }
.skill-goal { font-size: calc(22 * var(--u)); color: var(--text-tertiary); }
.skill-main .tag-outline { align-self: flex-start; }
/* statusClass 由 js 产出的值，仅在此着色 */
.s-learning { color: var(--primary); border-color: var(--primary); }
.s-lit { color: var(--success); border-color: var(--success); }

.skill-ops { display: flex; gap: calc(12 * var(--u)); flex: none; }
.op {
  font-size: calc(21 * var(--u)); font-weight: 500;
  color: var(--primary);
  padding: calc(8 * var(--u)) calc(16 * var(--u));
  background: transparent;
  border: 1px solid var(--glass-border);
  border-radius: var(--radius-sm);
}
.op-danger { color: var(--danger); border-color: var(--danger); }

/* ---------- v4：图标底板 / 页头 / 统计卡 ---------- */
.sk-head { display: flex; align-items: center; gap: calc(18 * var(--u)); margin-bottom: calc(24 * var(--u)); }
.sk-head-txt { flex: 1; min-width: 0; }
.sk-head-txt .sk-h1 { margin-bottom: calc(6 * var(--u)); }
.sk-head-txt .sk-sub { margin-bottom: 0; }
.card-title-row .icon-badge { margin-right: calc(12 * var(--u)); }
.sheet-head .icon-badge { margin-right: calc(12 * var(--u)); }
.cat-row { gap: calc(10 * var(--u)); }
/* .cat-row / .skill-item 的 .icon-badge flex:none 由 app.wxss 统一提供，勿重复 */
.sk-list { margin-bottom: calc(4 * var(--u)); }
