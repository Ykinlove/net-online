<view class="page sk">

  <view class="card">
    <view class="card-title-row">
      <text class="card-title">🌳 分类技能等级</text>
      <text class="card-more">由命令/项目自动推断</text>
    </view>
    <view wx:if="{{!cats.length}}" class="empty">记几条命令，这里会出现分类等级</view>
    <view wx:for="{{cats}}" wx:key="key" class="cat-row">
      <text class="cat-name">{{item.name}}</text>
      <view class="bar"><view class="bar-fill" style="width:{{item.pct}}%"></view></view>
      <text class="cat-lv">Lv.{{item.level}}</text>
      <text class="cat-n">{{item.count}}</text>
    </view>
  </view>

  <view class="card">
    <view class="card-title-row">
      <text class="card-title">🎯 我的技能</text>
      <text class="card-more" bindtap="openAdd">+ 新增</text>
    </view>

    <view class="tabs">
      <view
        wx:for="{{tabs}}"
        wx:key="key"
        class="tab {{tab === item.key ? 'on' : ''}}"
        data-v="{{item.key}}"
        bindtap="setTab"
      >{{item.name}} {{item.n}}</view>
    </view>

    <view wx:if="{{!list.length}}" class="empty">这里还没有技能</view>

    <view wx:for="{{list}}" wx:key="_key" class="skill-item">
      <view class="skill-main">
        <text class="skill-name">{{item.name}}</text>
        <text wx:if="{{item.goalText}}" class="skill-goal">{{item.goalText}}</text>
        <text class="skill-status {{item.statusClass}}">{{item.statusText}}</text>
      </view>
      <view class="skill-ops">
        <text class="op" data-idx="{{index}}" catchtap="cycleStatus">切换</text>
        <text class="op op-danger" data-idx="{{index}}" catchtap="askDelete">删除</text>
      </view>
    </view>
  </view>

  <!-- 新增技能 -->
  <view wx:if="{{formOpen}}" class="mask" bindtap="closeForm">
    <view class="sheet" catchtap="noop">
      <view class="sheet-head">
        <text class="sheet-title">新增技能</text>
        <text class="sheet-close" bindtap="closeForm">×</text>
      </view>
      <view class="field">
        <text class="field-label">技能名 <text class="req">*</text></text>
        <input class="input" value="{{form.name}}" maxlength="20" placeholder="比如：HCIE / OSPF 排障" placeholder-class="input-placeholder" placeholder-style="color:#9fb0c0;font-size:calc(27 * var(--u));" data-k="name" bindinput="onFormInput" />
      </view>
      <view class="field">
        <text class="field-label">状态</text>
        <view class="seg">
          <view
            wx:for="{{statusList}}"
            wx:key="k"
            class="seg-item {{form.status === item.k ? 'on' : ''}}"
            data-v="{{item.k}}"
            bindtap="pickStatus"
          >{{item.name}}</view>
        </view>
      </view>
      <view class="field">
        <text class="field-label">目标（可选）</text>
        <input class="input" value="{{form.goalText}}" maxlength="40" placeholder="比如：半年内拿下 HCIE" placeholder-class="input-placeholder" placeholder-style="color:#9fb0c0;font-size:calc(27 * var(--u));" data-k="goalText" bindinput="onFormInput" />
      </view>
      <view class="btn btn-primary btn-block" bindtap="saveForm">保存</view>
    </view>
  </view>
</view>
