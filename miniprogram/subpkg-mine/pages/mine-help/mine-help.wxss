.hp { padding-bottom: calc(60 * var(--u)); }

.hp-head { padding: calc(8 * var(--u)) calc(8 * var(--u)) calc(10 * var(--u)); }
.hp-head .doc-h1 { display: block; }
.hp-head .doc-sub { display: block; margin-top: calc(8 * var(--u)); }

/* 引言：复用全局 .quote（primary 左竖条 + primary-bg 底），不再用金色警示色 */
.hp-lead { display: block; margin-bottom: calc(8 * var(--u)); }
.hp-lead-d {
  display: block;
  font-size: calc(23 * var(--u));
  line-height: 1.7;
}

/* 条目：复用全局 .list-item 做底部分割线，收紧一点纵向留白 */
.hp-sec { margin-bottom: calc(8 * var(--u)); }
.hp-item { padding: calc(16 * var(--u)) calc(8 * var(--u)); }
.hp-p {
  display: block;
  font-size: calc(23 * var(--u));
  line-height: 1.75;
  color: var(--text-secondary);
}

.hp-foot { padding: calc(28 * var(--u)) calc(8 * var(--u)) 0; text-align: center; }
.hp-foot-t { display: block; font-size: calc(22 * var(--u)); font-weight: 600; color: var(--text-tertiary); }
.hp-foot-d { display: block; margin-top: calc(6 * var(--u)); font-size: calc(20 * var(--u)); color: var(--text-tertiary); }
