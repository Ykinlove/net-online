<view class="page st theme-{{theme}}" data-theme="{{theme}}" style="--dur:{{dur || 0.28}}s">

  <view class="st-head">
    <view class="hd-txt">
      <text class="doc-h1">设置</text>
      <text class="doc-sub">内容、工具与偏好</text>
    </view>
  </view>

  <!-- 浅色 / 深色已移到首页右上角一键切换；这里只留「跟随系统」总开关，
       否则用户点过太阳或月亮之后就再也回不到自动模式了。 -->
  <text class="section-title">外观</text>
  <view class="st-list">
    <view class="list-item row" bindtap="onFollowSystem">
      <text class="row-label">跟随系统深色模式</text>
      <view class="tg {{followSystem ? 'on' : ''}} {{tgPress ? 'press' : ''}} {{tgPop ? 'pop' : ''}}"><view class="tg-knob"></view></view>
    </view>
    <view class="list-item row">
      <text class="row-label">动效速度</text>
      <text class="row-value">{{durLabel}}</text>
    </view>
    <view class="liquid {{liquidDragging ? 'dragging' : ''}}" bindtouchstart="onLiquidStart" bindtouchmove="onLiquidMove" bindtouchend="onLiquidEnd">
      <view class="liquid-track"><view class="liquid-fill" style="width:{{liquidPct}}%"></view></view>
      <view class="liquid-knob" style="left:{{liquidPct}}%"></view>
    </view>
  </view>
  <text class="st-tip st-tip-tight">浅色 / 深色在首页右上角「太阳 / 月亮」一键切换。</text>

  <!-- 技能树 / 存档库移到了「我的」页；剩下的工具与关于合成一组，
       少一个分组标题，页面不会因为少了两行而显得下面空一片 -->
  <text class="section-title">关于与工具</text>
  <view class="st-list">
    <view class="list-item row" bindtap="exportData" hover-class="row-hover">
      <text class="row-label">导出数据</text>
      <text class="row-value">Excel 表格</text>
      <text class="row-arrow">›</text>
    </view>
    <!-- 微信 button 内置样式优先级很高，用 .row-fb 逐条 !important 压掉 -->
    <button class="row row-fb" open-type="feedback" hover-class="row-fb-hover">
      <text class="row-label">意见反馈</text>
      <text class="row-arrow">›</text>
    </button>
    <view class="list-item row" bindtap="goMaker" hover-class="row-hover">
      <text class="row-label">制作人</text>
      <text class="row-value">杨雷鹏</text>
      <text class="row-arrow">›</text>
    </view>
    <view class="list-item row" bindtap="copyWechat" hover-class="row-hover">
      <text class="row-label">联系微信</text>
      <text class="row-value">Ykinlove11</text>
      <text class="row-arrow">›</text>
    </view>
  </view>
  <text class="st-tip">点「联系微信」可以把微信号复制下来。数据保存在微信云开发，同一个微信换手机登录会自动同步。</text>

</view>
