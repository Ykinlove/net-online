<view class="page cg theme-{{theme}}" data-theme="{{theme}}" style="--dur:{{dur || 0.28}}s">

  <view class="cg-head">
    <view class="cg-head-txt">
      <text class="doc-h1 cg-h1">选择角色</text>
      <text class="doc-sub cg-sub">挑一个工程师形象，配一张场景，做成你的名片</text>
    </view>
  </view>

  <!-- 预览：像素场景 + 立绘 + 玻璃姓名条 -->
  <view class="cg-preview">
    <image class="cg-preview-bg" src="{{bgImage}}" mode="aspectFill" />
    <view class="illus-dim"></view>
    <image class="cg-preview-char" src="{{charImage}}" mode="aspectFit" />
    <view class="illus-veil"></view>
    <view class="cg-name">{{nickname || '你的工程师'}}</view>
  </view>

  <text class="section-title">选择形象</text>
  <view class="card">
    <view class="card-title-row">
      <text class="card-title">工程师形象</text>
    </view>
    <view class="cg-grid stagger">
      <view
        wx:for="{{chars}}"
        wx:key="id"
        class="illus cg-cell stagger-item sd-{{index}} {{item.on ? 'on' : ''}} {{item.locked ? 'is-lock' : ''}}"
        data-v="{{item.id}}"
        bindtap="pickCharFn"
      >
        <image class="illus-char" src="/images/portrait/{{item.id}}.png" mode="aspectFill" />
        <view wx:if="{{item.locked}}" class="cg-lock">
          <image class="icon icon-md" src="/images/icons/{{theme || 'light'}}/lock.png" mode="aspectFit" />
        </view>
        <view wx:if="{{item.on}}" class="cg-check">
          <image class="icon icon-xs" src="/images/icons/{{theme || 'light'}}/check.png" mode="aspectFit" />
        </view>
      </view>
    </view>
  </view>

  <text class="section-title">选择场景</text>
  <view class="card">
    <view class="card-title-row">
      <text class="card-title">名片背景</text>
    </view>
    <view class="cg-bg-row stagger">
      <view
        wx:for="{{bgs}}"
        wx:key="id"
        class="illus cg-bg-cell stagger-item sd-{{index}} {{item.on ? 'on' : ''}} {{item.locked ? 'is-lock' : ''}}"
        data-v="{{item.id}}"
        bindtap="pickBgFn"
      >
        <image class="illus-bg" src="/images/preset/bg/{{item.id}}.jpg" mode="aspectFill" />
        <view class="illus-dim"></view>
        <view wx:if="{{item.locked}}" class="cg-lock">
          <image class="icon icon-md" src="/images/icons/{{theme || 'light'}}/lock.png" mode="aspectFit" />
        </view>
        <view wx:if="{{item.on}}" class="cg-check">
          <image class="icon icon-xs" src="/images/icons/{{theme || 'light'}}/check.png" mode="aspectFit" />
        </view>
      </view>
    </view>
  </view>

  <view class="btn btn-primary btn-block cg-submit" bindtap="confirm">就用这个形象</view>
</view>
