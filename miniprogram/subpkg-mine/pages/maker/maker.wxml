<!-- pages/maker/maker.wxml —— 制作人页 -->
<view class="page maker-page">

  <view class="card head-card">
    <view class="maker-avatar">👤</view>
    <text class="maker-name">杨雷鹏</text>
    <text class="maker-desc">Net 操作命令速记 · 制作人</text>
  </view>

  <view class="card">
    <view class="card-title-row"><text class="card-title">管理入口</text></view>
    <view class="menu-row" bindtap="goAdmin" hover-class="menu-row-hover">
      <text class="menu-ico">🛠️</text>
      <text class="menu-txt">内容管理</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-row" bindtap="goContribute" hover-class="menu-row-hover">
      <text class="menu-ico">📝</text>
      <text class="menu-txt">贡献内容</text>
      <text class="menu-arrow">›</text>
    </view>
  </view>

  <text class="maker-foot">内容管理：作者发布云端热更新（改完即生效）。贡献内容：提交命令百科 / 模板供作者审核。</text>

</view>
