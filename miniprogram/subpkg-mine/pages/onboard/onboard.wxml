<view class="page ob theme-{{theme}}" data-theme="{{theme}}" style="--dur:{{dur || 0.28}}s">

  <view class="ob-head">
    <view class="hd-txt">
      <text class="doc-h1">建立你的工程师档案</text>
      <text class="doc-sub">这些配置不会定义你，但会成为角色成长的初始养料</text>
    </view>
  </view>

  <!-- 选择头像：8 个头肩像，横向滚动；完整形象与名片背景在下一层 -->
  <view class="ob-sec-row">
    <text class="section-title">选择头像</text>
    <text class="ob-sec-more" bindtap="goChargen">更多形象与背景 ›</text>
  </view>
  <scroll-view class="avatar-scroll" scroll-x>
    <view class="avatar-strip">
      <view
        wx:for="{{avatars}}"
        wx:key="no"
        class="illus round avatar-circle av-{{item.no}} {{avatarIdx === index ? 'avatar-active' : ''}}"
        data-idx="{{index}}"
        bindtap="onPickAvatar"
      >
        <image class="illus-char" src="{{item.img}}" mode="aspectFill" />
      </view>
    </view>
  </scroll-view>

  <text class="section-title">基础信息</text>
  <view class="card">
    <view class="field">
      <text class="field-label">昵称 <text class="req">*</text></text>
      <input class="input {{focusK === 'nickname' ? 'input-focus' : ''}}" value="{{form.nickname}}" maxlength="20" placeholder="{{nickPh}}" placeholder-class="input-placeholder" placeholder-style="color:var(--text-tertiary);font-size:calc(27 * var(--u));" data-k="nickname" data-fk="nickname" bindinput="onInput" bindfocus="onFieldFocus" bindblur="onFieldBlur" />
    </view>

    <view class="field">
      <text class="field-label">单位 / 学校</text>
      <input class="input {{focusK === 'org' ? 'input-focus' : ''}}" value="{{form.org}}" maxlength="40" placeholder="" placeholder-class="input-placeholder" placeholder-style="color:var(--text-tertiary);font-size:calc(27 * var(--u));" data-k="org" data-fk="org" bindinput="onInput" bindfocus="onFieldFocus" bindblur="onFieldBlur" />
    </view>

    <view class="field">
      <text class="field-label">专业 / 方向</text>
      <input class="input {{focusK === 'major' ? 'input-focus' : ''}}" value="{{form.major}}" maxlength="40" placeholder="" placeholder-class="input-placeholder" placeholder-style="color:var(--text-tertiary);font-size:calc(27 * var(--u));" data-k="major" data-fk="major" bindinput="onInput" bindfocus="onFieldFocus" bindblur="onFieldBlur" />
    </view>

    <view class="field">
      <text class="field-label">年级 / 阶段</text>
      <picker mode="selector" range="{{stages}}" value="{{stageIdx}}" bindchange="onStage">
        <view class="input picker-box">
          <text class="{{form.stage ? '' : 'ph'}}">{{form.stage || '请选择'}}</text>
          <text class="picker-caret">▾</text>
        </view>
      </picker>
    </view>

    <view class="field">
      <text class="field-label">一句话描述</text>
      <input class="input {{focusK === 'oneLineDesc' ? 'input-focus' : ''}}" value="{{form.oneLineDesc}}" maxlength="30" placeholder="" placeholder-class="input-placeholder" placeholder-style="color:var(--text-tertiary);font-size:calc(27 * var(--u));" data-k="oneLineDesc" data-fk="oneLineDesc" bindinput="onInput" bindfocus="onFieldFocus" bindblur="onFieldBlur" />
    </view>
  </view>

  <text class="section-title">兴趣关键词</text>
  <view class="card">
    <view class="kw-head">
      <text class="field-label">已添加</text>
      <text class="kw-tip">{{interests.length}}/8</text>
    </view>
    <view class="kw-tags">
      <view class="kw-chip" wx:for="{{interests}}" wx:key="*this">
        <text class="kw-text">{{item}}</text>
        <text class="kw-x" catchtap="removeKw" data-kind="interests" data-idx="{{index}}">×</text>
      </view>
      <text wx:if="{{!interests.length}}" class="kw-empty">还没有关键词，在下面输入后点添加</text>
    </view>
    <view class="kw-row">
      <input class="input kw-input {{focusK === 'kwInterests' ? 'input-focus' : ''}}" value="{{kwInput.interests}}" maxlength="20" placeholder="" placeholder-class="input-placeholder" placeholder-style="color:var(--text-tertiary);font-size:calc(27 * var(--u));" data-kind="interests" data-fk="kwInterests" bindinput="onKwInput" bindconfirm="addKw" confirm-type="done" confirm-hold bindfocus="onFieldFocus" bindblur="onFieldBlur" />
      <view class="btn btn-sm kw-add" catchtap="addKw" data-kind="interests">添加</view>
    </view>
  </view>

  <text class="section-title">职业关键词</text>
  <view class="card">
    <view class="kw-head">
      <text class="field-label">已添加</text>
      <text class="kw-tip">{{careers.length}}/8</text>
    </view>
    <view class="kw-tags">
      <view class="kw-chip chip-gold" wx:for="{{careers}}" wx:key="*this">
        <text class="kw-text">{{item}}</text>
        <text class="kw-x" catchtap="removeKw" data-kind="careers" data-idx="{{index}}">×</text>
      </view>
      <text wx:if="{{!careers.length}}" class="kw-empty">还没有关键词，在下面输入后点添加</text>
    </view>
    <view class="kw-row">
      <input class="input kw-input {{focusK === 'kwCareers' ? 'input-focus' : ''}}" value="{{kwInput.careers}}" maxlength="20" placeholder="" placeholder-class="input-placeholder" placeholder-style="color:var(--text-tertiary);font-size:calc(27 * var(--u));" data-kind="careers" data-fk="kwCareers" bindinput="onKwInput" bindconfirm="addKw" confirm-type="done" confirm-hold bindfocus="onFieldFocus" bindblur="onFieldBlur" />
      <view class="btn btn-sm kw-add" catchtap="addKw" data-kind="careers">添加</view>
    </view>
  </view>

  <view class="btn btn-primary btn-block ob-submit" bindtap="submit">{{editing ? '保存修改' : '保存并继续'}}</view>
  <view class="ob-note">资料、形象和名片背景都在「我的 → 编辑档案」里修改</view>
</view>
