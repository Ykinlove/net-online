.arc { padding-bottom: calc(60 * var(--u)); }

.arc-head { padding: calc(8 * var(--u)) calc(8 * var(--u)) calc(10 * var(--u)); }
.arc-head .doc-h1 { display: block; }
.arc-head .doc-sub { display: block; margin-top: calc(8 * var(--u)); }

/* 列表项：去外框改底部分割线（全局 .list-item），这里只做内部纵向排布 */
.arc-card {
  display: flex;
  flex-direction: column;
  gap: calc(14 * var(--u));
}
.arc-top { display: flex; align-items: center; }
.arc-name { flex: 1; font-size: calc(28 * var(--u)); font-weight: 600; color: var(--text-primary); }
.arc-time { font-size: calc(20 * var(--u)); color: var(--text-tertiary); }
.arc-stats { display: flex; flex-wrap: wrap; gap: calc(10 * var(--u)); }
.arc-stat {
  padding: calc(4 * var(--u)) calc(12 * var(--u));
  font-size: calc(20 * var(--u));
  font-weight: 500;
  color: var(--primary);
  background: var(--primary-bg);
  border: 1px solid var(--glass-border);
  border-radius: var(--radius-sm);
}
.arc-ops { display: flex; gap: calc(12 * var(--u)); }
