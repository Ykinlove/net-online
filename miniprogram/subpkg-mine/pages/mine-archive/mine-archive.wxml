<view class="page arc theme-{{theme}}" data-theme="{{theme}}" style="--dur:{{dur || 0.28}}s">

  <view class="arc-head">
    <view class="hd-txt">
      <text class="doc-h1">存档库</text>
      <text class="doc-sub">删除命令、项目、技能之前会自动存一份，保留最近 5 份。删错了就挑一份恢复。</text>
    </view>
  </view>

  <text class="section-title">存档记录 · {{list.length}} / 5 份</text>

  <view wx:if="{{!list.length}}" class="empty">还没有自动存档。等你第一次删除东西时会自动生成。</view>

  <view wx:for="{{list}}" wx:key="at" class="list-item arc-card stack-item sd-{{index}}">
    <view class="arc-top">
      <text class="arc-name">{{item.reason}}</text>
      <text class="arc-time">{{item.timeLabel}}</text>
    </view>
    <view class="arc-stats">
      <text class="arc-stat">{{item.cmdCount}} 条命令</text>
      <text class="arc-stat">{{item.projectCount}} 个项目</text>
      <text class="arc-stat">{{item.skillCount}} 个技能</text>
    </view>
    <view class="arc-ops">
      <view class="btn btn-sm btn-primary" data-at="{{item.at}}" bindtap="restore">恢复这份</view>
      <view class="btn btn-sm btn-danger" data-at="{{item.at}}" bindtap="askDelete">删除</view>
    </view>
  </view>
</view>
