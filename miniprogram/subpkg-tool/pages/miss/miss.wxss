/* 搜不到的说法：沿用像素风 */

.miss-page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  background: linear-gradient(180deg, #eaf4fb 0%, #f7fbfe 40%, #eef7fd 100%);
}

/* ---------- 顶部 ---------- */
.head {
  flex: none;
  padding: calc(26 * var(--u)) calc(28 * var(--u)) calc(16 * var(--u));
}
.head-main {
  display: flex;
  align-items: center;
  gap: calc(14 * var(--u));
}
.head-title {
  font-size: calc(32 * var(--u));
  font-weight: 800;
  color: #2c3e50;
  letter-spacing: calc(1 * var(--u));
}
.head-num {
  font-size: calc(20 * var(--u));
  font-weight: 800;
  color: #a35b3f;
  background: #fdeee7;
  border: calc(2 * var(--u)) solid #f0c4ac;
  border-radius: calc(16 * var(--u));
  padding: calc(2 * var(--u)) calc(14 * var(--u));
}
.head-sub {
  display: block;
  margin-top: calc(10 * var(--u));
  font-size: calc(21 * var(--u));
  color: #7c8fa3;
  line-height: 1.5;
}

/* ---------- 列表 ---------- */
.list {
  flex: 1;
  min-height: 0;
  box-sizing: border-box;
  padding: 0 calc(24 * var(--u));
}

.item {
  display: flex;
  align-items: center;
  gap: calc(12 * var(--u));
  background: #fffdf6;
  border: calc(3 * var(--u)) solid #2c3e50;
  border-radius: calc(8 * var(--u));
  padding: calc(16 * var(--u)) calc(20 * var(--u));
  margin-bottom: calc(14 * var(--u));
  box-shadow: 0 calc(5 * var(--u)) 0 rgba(44, 62, 80, 0.14);
}
.item-hover {
  transform: translateY(calc(3 * var(--u)));
  box-shadow: 0 calc(2 * var(--u)) 0 rgba(44, 62, 80, 0.14);
}
.item-main { flex: 1; min-width: 0; }
.item-kw {
  display: block;
  font-size: calc(26 * var(--u));
  font-weight: 800;
  color: #2c3e50;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.item-meta {
  display: block;
  margin-top: calc(6 * var(--u));
  font-size: calc(19 * var(--u));
  color: #9fb0c0;
}
.item-arrow {
  flex: none;
  font-size: calc(30 * var(--u));
  color: #b9cfe0;
}

/* 空态 */
.empty {
  padding: calc(90 * var(--u)) calc(40 * var(--u));
  text-align: center;
}
.empty-ico { font-size: calc(56 * var(--u)); }
.empty-txt {
  display: block;
  margin-top: calc(16 * var(--u));
  font-size: calc(24 * var(--u));
  color: #7c8fa3;
}
.empty-sub {
  display: block;
  margin-top: calc(8 * var(--u));
  font-size: calc(21 * var(--u));
  color: #9fb0c0;
  line-height: 1.6;
}

.list-foot { height: calc(40 * var(--u)); }

/* ---------- 底部操作 ---------- */
.foot {
  flex: none;
  display: flex;
  gap: calc(14 * var(--u));
  padding: calc(14 * var(--u)) calc(24 * var(--u)) calc(28 * var(--u));
  border-top: calc(3 * var(--u)) dashed #d9e4ee;
  background: #f4f9fd;
}
.foot-btn {
  flex: 1;
  height: calc(80 * var(--u));
  line-height: calc(80 * var(--u));
  text-align: center;
  font-size: calc(26 * var(--u));
  font-weight: 800;
  border-radius: calc(10 * var(--u));
}
.foot-btn-main {
  color: #2c3e50;
  background: #ffd86b;
  border: calc(4 * var(--u)) solid #2c3e50;
  box-shadow: 0 calc(6 * var(--u)) 0 rgba(44, 62, 80, 0.25);
}
.foot-btn-ghost {
  flex: none;
  width: calc(180 * var(--u));
  color: #7c8fa3;
  background: #eef4f9;
  border: calc(3 * var(--u)) solid #cfe0ee;
}
