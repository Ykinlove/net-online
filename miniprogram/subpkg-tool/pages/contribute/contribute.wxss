/* pages/contribute/contribute.wxss —— 复用全局卡片系统，仅补充专属样式 */
.head-card { padding: calc(20 * var(--u)) calc(24 * var(--u)); }
.head-card .card-title { margin: 0; }
.head-sub { display: block; font-size: calc(23 * var(--u)); color: #6b7d8f; margin-top: calc(10 * var(--u)); line-height: 1.5; }

.locate { display: flex; align-items: center; gap: calc(16 * var(--u)); }
.locate-input { flex: 1; }
.locate-btn { flex-shrink: 0; }
.locate-ok { margin-top: calc(16 * var(--u)); font-size: calc(23 * var(--u)); color: #1a7f4b; font-weight: 700; }

/* 厂商命令卡片 */
.vendor-card {
  background: #fff;
  border: calc(3 * var(--u)) solid #cfe0ee;
  border-radius: calc(10 * var(--u));
  padding: calc(16 * var(--u)) calc(18 * var(--u));
  margin-bottom: calc(16 * var(--u));
}
.vendor-head { display: flex; align-items: center; gap: calc(12 * var(--u)); margin-bottom: calc(10 * var(--u)); }
.vendor-name-input { flex: 1; }
.vendor-del { font-size: calc(23 * var(--u)); color: #a32e2a; font-weight: 700; flex-shrink: 0; }
.vendor-code { min-height: calc(200 * var(--u)); }
.add-link { color: #c97a14; font-weight: 700; }

/* 结果提示 */
.err {
  margin-top: calc(18 * var(--u));
  font-size: calc(24 * var(--u)); color: #a32e2a; font-weight: 700;
  background: #ffe9e7; border: calc(3 * var(--u)) solid #e08a86;
  border-radius: calc(8 * var(--u)); padding: calc(14 * var(--u)) calc(18 * var(--u));
}
.ok {
  margin-top: calc(18 * var(--u));
  font-size: calc(24 * var(--u)); color: #1a7f4b; font-weight: 700;
  background: #e8f8ee; border: calc(3 * var(--u)) solid #6fc79a;
  border-radius: calc(8 * var(--u)); padding: calc(14 * var(--u)) calc(18 * var(--u));
}
