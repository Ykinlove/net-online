<view class="search-page">

  <!-- 搜索框 -->
  <view class="sb-wrap">
    <view class="sb">
      <text class="sb-ico">🔍</text>
      <input
        class="sb-input"
        value="{{kw}}"
        placeholder="搜功能，比如「划分端口」"
        placeholder-style="color:#9fb0c0;font-size:calc(26 * var(--u));"
        confirm-type="search"
        bindinput="onInput"
        bindconfirm="onConfirm"
      />
      <text wx:if="{{kw}}" class="sb-clear" bindtap="clearKw">✕</text>
    </view>

    <!-- 搜索历史：空输入时显示最近搜过的，点一下直接搜 -->
    <view wx:if="{{!kw && history.length}}" class="hist">
      <view class="hist-head">
        <text class="hist-title">最近搜过</text>
        <text class="hist-clear" bindtap="clearHistory">清空</text>
      </view>
      <view class="hist-list">
        <text
          wx:for="{{history}}"
          wx:key="kw"
          class="hist-chip"
          bindtap="pickHistory"
          data-kw="{{item.kw}}"
        >{{item.kw}}</text>
      </view>
    </view>
  </view>

  <!-- 左：设备筛选  右：结果 -->
  <view class="body">

    <scroll-view class="side" scroll-y>
      <view
        wx:for="{{sideList}}"
        wx:key="v"
        class="side-item {{dev === item.v ? 'on' : ''}}"
        bindtap="pickDev"
        data-v="{{item.v}}"
      >{{item.t}}</view>
    </scroll-view>

    <scroll-view class="main" scroll-y bindscrolltolower="loadMore">

      <!-- 命令百科 -->
      <block wx:if="{{bookHits.length}}">
        <view class="grp">
          <text class="grp-name">命令百科</text>
          <text class="grp-num">{{bookTotal}} 条</text>
        </view>
        <view
          wx:for="{{bookHits}}"
          wx:key="id"
          class="bk-item"
          bindtap="openBook"
          data-idx="{{index}}"
          hover-class="bk-item-hover"
        >
          <view class="bk-top">
            <text class="bk-name">{{item.name}}</text>
            <text class="bk-arrow">›</text>
          </view>
          <view class="bk-tags">
            <text
              wx:for="{{item.cmds}}"
              wx:for-item="c"
              wx:key="vendor"
              class="bk-tag"
            >{{c.vendor}}</text>
          </view>
        </view>
      </block>

      <!-- 配置模板：复制就能用，排在「我的命令」前面 -->
      <block wx:if="{{tplHits.length}}">
        <view class="grp">
          <text class="grp-name">配置模板</text>
          <text class="grp-num">{{tplHits.length}} 个</text>
        </view>
        <view
          wx:for="{{tplHits}}"
          wx:key="id"
          class="bk-item"
          bindtap="openTpl"
          data-idx="{{index}}"
          hover-class="bk-item-hover"
        >
          <view class="bk-top">
            <text class="bk-name">{{item.name}}</text>
            <text class="bk-arrow">›</text>
          </view>
          <view class="bk-tags">
            <text class="bk-tag">{{item.cat}}</text>
            <text class="bk-tag">{{item.vendor}}</text>
          </view>
        </view>
      </block>

      <!-- 我的命令 -->
      <block wx:if="{{mineHits.length}}">
        <view class="grp">
          <text class="grp-name">我的命令</text>
          <text class="grp-num">{{mineHits.length}} 条</text>
        </view>
        <view
          wx:for="{{mineHits}}"
          wx:key="_key"
          class="my-item"
          bindtap="openMine"
          data-idx="{{index}}"
          hover-class="bk-item-hover"
        >
          <view class="my-main">
            <text class="my-title">{{item.title}}</text>
            <text class="my-code">{{item.preview}}</text>
          </view>
          <text class="my-dev">{{item.devText}}</text>
        </view>
      </block>

      <!-- 加载更多 -->
      <view wx:if="{{hasMore}}" class="more" bindtap="loadMore" hover-class="more-hover">
        <text class="more-txt">{{bookHits.length}} / {{bookTotal}} · 上滑加载更多</text>
      </view>

      <!-- 空态 -->
      <view wx:if="{{!hitTotal}}" class="hint">
        <text class="hint-ico">🔍</text>
        <text class="hint-txt">没找到{{kw ? '「' + kw + '」' : ''}}相关的命令</text>
        <text wx:if="{{dev !== '全部'}}" class="hint-sub">「{{devText}}」下没有，把左边切到「全部」试试</text>
        <text wx:else class="hint-sub">换个说法试试，比如「vlan」「路由」「保存」</text>
      </view>

      <view class="main-foot"></view>
    </scroll-view>
  </view>

  <!-- 详情浮层 -->
  <view wx:if="{{detail}}" class="mask" bindtap="closeDetail">
    <view class="sheet" catchtap="noop">

      <view class="sheet-head">
        <view class="sheet-title-box">
          <text class="sheet-title">{{detail.title}}</text>
          <text class="sheet-sub">{{detail.sub}}</text>
        </view>
        <view class="sheet-ops">
          <text wx:if="{{detail.favKind}}" class="fav-btn {{detail.faved ? 'fav-btn-on' : ''}}"
            bindtap="toggleFav">{{detail.faved ? '★ 已收藏' : '☆ 收藏'}}</text>
          <text wx:if="{{detail.favKind}}" class="fav-btn" bindtap="shareBtn"
            open-type="share">转发</text>
          <text class="sheet-close" bindtap="closeDetail">✕</text>
        </view>
      </view>

      <scroll-view class="sheet-body" scroll-y>
        <view wx:if="{{detail.tip}}" class="sheet-tip">
          <text class="sheet-tip-ico">💡</text>
          <text class="sheet-tip-txt">{{detail.tip}}</text>
        </view>

        <view wx:for="{{detail.blocks}}" wx:key="vendor" class="vd">
          <view class="vd-head">
            <text class="vd-name">{{item.vendor}}</text>
            <text class="vd-copy" catchtap="copyOne" data-i="{{index}}">复制</text>
          </view>
          <view class="vd-code">
            <text
              wx:for="{{item.lines}}"
              wx:for-item="ln"
              wx:key="index"
              class="vd-line {{ln.note ? 'vd-line-note' : ''}}"
            >{{ln.t}}</text>
          </view>
        </view>
      </scroll-view>

      <!-- 单块命令（模板 / 我的命令）也要有一键复制：
           原来只在多块时才显示底部按钮，单块的用户只能逐块点「复制」。 -->
      <view class="sheet-foot">
        <view class="sheet-btn" bindtap="copyAll" hover-class="sheet-btn-hover">
          {{detail.blocks.length > 1 ? '复制全部命令' : '复制命令'}}
        </view>
      </view>

    </view>
  </view>
</view>
