/* 搜索页：知识库文档风 —— 顶部搜索框 + 左侧设备筛选 + 右侧结果
   颜色一律 var(--token)，尺寸一律 calc(N * var(--u))（1px 细边框除外）。 */

.search-page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  background: var(--bg-page);
}

/* ---------- 搜索框：全局 .input + 单色线性放大镜 ---------- */
.sb-wrap {
  flex: none;
  padding: calc(20 * var(--u)) calc(24 * var(--u)) calc(14 * var(--u));
}
.sb { position: relative; }
/* 放大镜是真实 image：绝对定位，避免挤压 input 撑高搜索区 */
.sb > .icon {
  position: absolute;
  left: calc(22 * var(--u));
  top: 50%;
  transform: translateY(-50%);
  z-index: 1;
}
.sb-input {
  width: 100%;
  padding-left: calc(72 * var(--u));
  padding-right: calc(64 * var(--u));
}
.sb-clear {
  position: absolute;
  right: calc(20 * var(--u));
  top: 50%;
  transform: translateY(-50%);
  z-index: 1;
  width: calc(40 * var(--u));
  height: calc(40 * var(--u));
  line-height: calc(40 * var(--u));
  text-align: center;
  font-size: calc(21 * var(--u));
  color: var(--text-tertiary);
  background: var(--bg-subtle);
  border-radius: 50%;
}

/* ---------- 搜索历史 ---------- */
.hist {
  padding: calc(4 * var(--u)) calc(24 * var(--u)) calc(16 * var(--u));
}
.hist-head {
  display: flex;
  align-items: center;
  margin-bottom: calc(12 * var(--u));
}
.hist-title {
  font-size: calc(21 * var(--u));
  font-weight: 600;
  color: var(--text-tertiary);
  letter-spacing: calc(2 * var(--u));
}
.hist-clear {
  margin-left: auto;
  font-size: calc(20 * var(--u));
  color: var(--primary);
}
.hist-list {
  display: flex;
  flex-wrap: wrap;
  gap: calc(10 * var(--u));
}
.hist-chip {
  font-size: calc(21 * var(--u));
  color: var(--text-secondary);
  background: var(--glass-bg);
  -webkit-backdrop-filter: blur(18px) saturate(160%);
  backdrop-filter: blur(18px) saturate(160%);
  border: 1px solid var(--glass-border);
  border-radius: var(--radius-sm);
  padding: calc(8 * var(--u)) calc(18 * var(--u));
}

/* 命中关键词高亮 */
.hl {
  color: var(--primary);
  background: var(--primary-bg);
  border-radius: calc(3 * var(--u));
  padding: 0 calc(2 * var(--u));
}

/* 空态里的「换个说法」入口 */
.hint-chips {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: calc(12 * var(--u));
  margin-top: calc(18 * var(--u));
}
.hint-chip {
  font-size: calc(21 * var(--u));
  color: var(--text-secondary);
  background: var(--glass-bg);
  -webkit-backdrop-filter: blur(18px) saturate(160%);
  backdrop-filter: blur(18px) saturate(160%);
  border: 1px solid var(--glass-border);
  border-radius: var(--radius-sm);
  padding: calc(8 * var(--u)) calc(18 * var(--u));
}

/* ---------- 主体 ---------- */
.body {
  flex: 1;
  min-height: 0;
  display: flex;
}

/* 左侧设备筛选：选中态等价 .seg-item.on（蓝底白字） */
.side {
  width: calc(152 * var(--u));
  flex: none;
  height: 100%;
  box-sizing: border-box;
  background: var(--glass-bg);
  -webkit-backdrop-filter: blur(18px) saturate(160%);
  backdrop-filter: blur(18px) saturate(160%);
  border-right: 1px solid var(--border);
}
.side-item {
  height: calc(86 * var(--u));
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: calc(23 * var(--u));
  font-weight: 600;
  color: var(--text-secondary);
  background: var(--glass-bg);
  -webkit-backdrop-filter: blur(18px) saturate(160%);
  backdrop-filter: blur(18px) saturate(160%);
  border: none;
  border-left: calc(4 * var(--u)) solid var(--border);
  border-radius: 0;
  padding: 0;
  box-sizing: border-box;
}
.side-item.on {
  color: var(--text-on-primary);
  background: var(--primary);
  border-left-color: var(--primary);
}

/* 右侧结果 */
.main {
  flex: 1;
  height: 100%;
  box-sizing: border-box;
  padding: 0 calc(20 * var(--u));
}
.grp {
  display: flex;
  align-items: center;
  gap: calc(10 * var(--u));
  padding: calc(22 * var(--u)) calc(4 * var(--u)) calc(12 * var(--u));
}
.grp-name {
  font-size: calc(22 * var(--u));
  font-weight: 600;
  color: var(--text-secondary);
  letter-spacing: calc(2 * var(--u));
}
/* 自己记的命令置顶，分组标题用主色 + 左侧细线点出来 */
.grp-mine {
  border-left: calc(4 * var(--u)) solid var(--primary);
  padding-left: calc(12 * var(--u));
}
.grp-mine .grp-name { color: var(--primary); }
.grp-num {
  margin-left: calc(12 * var(--u));
  font-size: calc(18 * var(--u));
  font-weight: 600;
  color: var(--primary);
  background: var(--primary-bg);
  border: 1px solid var(--glass-border);
  border-radius: calc(16 * var(--u));
  padding: calc(1 * var(--u)) calc(10 * var(--u));
  letter-spacing: 0;
}

/* 百科 / 模板条目：去外框，改底部分割线（全局 .list-item） */
.bk-item-hover { background: var(--bg-subtle); }
.bk-top {
  display: flex;
  align-items: center;
  gap: calc(8 * var(--u));
}
.bk-name {
  flex: 1;
  font-size: calc(26 * var(--u));
  font-weight: 600;
  line-height: 1.35;
  color: var(--text-primary);
}
.bk-arrow {
  flex: none;
  font-size: calc(30 * var(--u));
  color: var(--text-tertiary);
}
.bk-tags {
  display: flex;
  flex-wrap: wrap;
  gap: calc(8 * var(--u));
  margin-top: calc(10 * var(--u));
}
.bk-tag {
  font-size: calc(18 * var(--u));
  color: var(--text-secondary);
  background: var(--bg-subtle);
  border: 1px solid var(--glass-border);
  border-radius: var(--radius-sm);
  padding: calc(2 * var(--u)) calc(10 * var(--u));
}

/* 我的命令：同样分割线式，命令预览用等宽代码块 */
.my-item {
  display: flex;
  align-items: center;
  gap: calc(12 * var(--u));
}
.my-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: calc(6 * var(--u));
}
.my-title {
  font-size: calc(25 * var(--u));
  font-weight: 600;
  color: var(--text-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.my-code {
  font-family: var(--font-code);
  font-size: calc(19 * var(--u));
  color: var(--code-text);
  background: var(--code-bg);
  border: 1px solid var(--code-border);
  border-radius: var(--radius-sm);
  padding: calc(6 * var(--u)) calc(12 * var(--u));
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.my-dev {
  flex: none;
  font-size: calc(18 * var(--u));
  color: var(--primary);
  background: var(--primary-bg);
  border: 1px solid var(--glass-border);
  border-radius: var(--radius-sm);
  padding: calc(2 * var(--u)) calc(10 * var(--u));
}

/* 加载更多 */
.more {
  margin: calc(6 * var(--u)) 0 calc(10 * var(--u));
  padding: calc(26 * var(--u)) 0;
  text-align: center;
  background: var(--bg-subtle);
  border: 1px solid var(--glass-border);
  border-radius: var(--radius-md);
}
.more-hover { background: var(--glass-bg);
  -webkit-backdrop-filter: blur(18px) saturate(160%);
  backdrop-filter: blur(18px) saturate(160%); }
.more-txt {
  font-size: calc(23 * var(--u));
  font-weight: 500;
  color: var(--text-tertiary);
  letter-spacing: calc(0.5 * var(--u));
}

/* 空态：纯色几何图形替代 emoji 插画 */
.hint {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: calc(100 * var(--u)) calc(20 * var(--u));
}
.hint-txt {
  font-size: calc(25 * var(--u));
  font-weight: 600;
  color: var(--text-secondary);
  text-align: center;
}
.hint-sub {
  margin-top: calc(10 * var(--u));
  font-size: calc(21 * var(--u));
  color: var(--text-tertiary);
  text-align: center;
}
.main-foot { height: calc(40 * var(--u)); }

/* ---------- 详情浮层 ---------- */
.mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 50;
  display: flex;
  align-items: flex-end;
  background: var(--mask-bg);
}
.sheet {
  width: 100%;
  max-width: var(--W);
  margin-left: auto;
  margin-right: auto;
  max-height: 84vh;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  background: var(--glass-bg);
  -webkit-backdrop-filter: blur(18px) saturate(160%);
  backdrop-filter: blur(18px) saturate(160%);
  border-top: 1px solid var(--border);
  border-radius: var(--radius-lg) var(--radius-lg) 0 0;
  padding-bottom: env(safe-area-inset-bottom);
}
.sheet-head {
  flex: none;
  display: flex;
  align-items: flex-start;
  gap: calc(12 * var(--u));
  padding: calc(22 * var(--u)) calc(24 * var(--u)) calc(16 * var(--u));
  border-bottom: 1px solid var(--border);
}
.sheet-title-box {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: calc(4 * var(--u));
}
.sheet-title {
  font-size: calc(30 * var(--u));
  font-weight: 600;
  line-height: 1.35;
  color: var(--text-primary);
}
.sheet-sub { font-size: calc(20 * var(--u)); color: var(--text-tertiary); }
.sheet-close {
  flex: none;
  width: calc(52 * var(--u));
  height: calc(52 * var(--u));
  line-height: calc(52 * var(--u));
  text-align: center;
  font-size: calc(23 * var(--u));
  color: var(--text-tertiary);
  background: var(--bg-subtle);
  border-radius: 50%;
}
.sheet-ops {
  flex: none;
  display: flex;
  align-items: center;
  gap: calc(10 * var(--u));
}
.fav-btn {
  font-size: calc(20 * var(--u));
  font-weight: 500;
  color: var(--primary);
  background: var(--primary-bg);
  border: 1px solid var(--glass-border);
  border-radius: var(--radius-sm);
  padding: calc(4 * var(--u)) calc(14 * var(--u));
}
.fav-btn-on {
  color: var(--text-on-primary);
  background: var(--primary);
  border-color: var(--primary);
}
.sheet-body {
  flex: 1;
  min-height: calc(240 * var(--u));
  max-height: 62vh;
  box-sizing: border-box;
  padding: calc(18 * var(--u)) calc(24 * var(--u));
}
.sheet-tip { margin-bottom: calc(20 * var(--u)); }
.sheet-tip-txt {
  font-size: calc(21 * var(--u));
  line-height: 1.62;
  color: var(--text-secondary);
}

/* 单厂商块：厂商名描边标签 + 代码块 */
.vd { margin-bottom: calc(20 * var(--u)); }
.vd-head {
  display: flex;
  align-items: center;
  margin-bottom: calc(8 * var(--u));
}
.vd-copy {
  margin-left: auto;
  font-size: calc(19 * var(--u));
  color: var(--primary);
  background: var(--primary-bg);
  border: 1px solid var(--glass-border);
  border-radius: var(--radius-sm);
  padding: calc(3 * var(--u)) calc(16 * var(--u));
}

/* 代码块：等宽、横向滚动、右上角固定复制按钮（全局 .code-block/.code-scroll/.code-copy） */
.code-block {
  overflow: hidden;
  padding-top: calc(52 * var(--u));
}
.code-scroll { width: 100%; }
.code-inner {
  display: inline-block;
  min-width: 100%;
  white-space: pre;
}
.vd-line {
  display: block;
  font-family: var(--font-code);
  font-size: calc(22 * var(--u));
  line-height: 1.7;
  color: var(--code-text);
  white-space: pre;
}
.vd-line-note { color: var(--text-tertiary); }

/* 主按钮 .btn-primary */
.sheet-foot {
  flex: none;
  padding: calc(14 * var(--u)) calc(24 * var(--u)) calc(24 * var(--u));
  border-top: 1px solid var(--border);
}
.sheet-btn {
  width: 100%;
  height: calc(82 * var(--u));
  border-radius: var(--radius-md);
}
.sheet-btn-hover { opacity: 0.86; }
