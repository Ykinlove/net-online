/* 搜索页：顶部搜索框 + 左侧设备筛选 + 右侧结果 */

.search-page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  background: linear-gradient(180deg, #eaf4fb 0%, #f7fbfe 40%, #eef7fd 100%);
}

/* ---------- 搜索框 ---------- */
.sb-wrap {
  flex: none;
  padding: calc(20 * var(--u)) calc(24 * var(--u)) calc(14 * var(--u));
}

/* ---------- 搜索历史 ---------- */
.hist {
  padding: calc(4 * var(--u)) calc(24 * var(--u)) calc(16 * var(--u));
}
.hist-head {
  display: flex;
  align-items: center;
  margin-bottom: calc(12 * var(--u));
}
.hist-title {
  font-size: calc(21 * var(--u));
  font-weight: 800;
  color: #7c8fa3;
}
.hist-clear {
  margin-left: auto;
  font-size: calc(20 * var(--u));
  color: #b9cfe0;
}
.hist-list {
  display: flex;
  flex-wrap: wrap;
  gap: calc(10 * var(--u));
}
.hist-chip {
  font-size: calc(21 * var(--u));
  color: #2c3e50;
  background: #fffdf6;
  border: calc(2 * var(--u)) solid #cfe0ee;
  border-radius: calc(8 * var(--u));
  padding: calc(8 * var(--u)) calc(18 * var(--u));
}

/* 命中关键词高亮：在结果标题里把搜的词标黄，让人一眼看到为什么命中 */
.hl {
  color: #9a5b00;
  background: #ffe9b0;
  border-radius: calc(3 * var(--u));
  padding: 0 calc(2 * var(--u));
}

/* 空态里的「换个说法」入口：点一下直接搜 */
.hint-chips {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: calc(12 * var(--u));
  margin-top: calc(18 * var(--u));
}
.hint-chip {
  font-size: calc(21 * var(--u));
  color: #2c3e50;
  background: #fffdf6;
  border: calc(2 * var(--u)) solid #cfe0ee;
  border-radius: calc(8 * var(--u));
  padding: calc(8 * var(--u)) calc(18 * var(--u));
}
.sb {
  display: flex;
  align-items: center;
  gap: calc(12 * var(--u));
  height: calc(88 * var(--u));
  padding: 0 calc(22 * var(--u));
  box-sizing: border-box;
  background: #fffdf6;
  border: calc(4 * var(--u)) solid #2c3e50;
  border-radius: calc(10 * var(--u));
  box-shadow: 0 calc(6 * var(--u)) 0 rgba(44, 62, 80, 0.18);
}
.sb-ico { font-size: calc(26 * var(--u)); }
.sb-input {
  flex: 1;
  height: 100%;
  font-size: calc(27 * var(--u));
  color: #2c3e50;
}
.sb-clear {
  flex: none;
  width: calc(42 * var(--u));
  height: calc(42 * var(--u));
  line-height: calc(42 * var(--u));
  text-align: center;
  font-size: calc(21 * var(--u));
  color: #7c8fa3;
  background: #eef2f6;
  border-radius: 50%;
}

/* ---------- 主体 ---------- */
.body {
  flex: 1;
  min-height: 0;
  display: flex;
}

/* 左侧设备筛选 */
.side {
  width: calc(152 * var(--u));
  flex: none;
  height: 100%;
  box-sizing: border-box;
  background: rgba(255, 253, 246, 0.86);
  border-right: calc(3 * var(--u)) solid #d5e3ee;
}
.side-item {
  height: calc(86 * var(--u));
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: calc(23 * var(--u));
  font-weight: 700;
  color: #5a6b7d;
  border-left: calc(8 * var(--u)) solid transparent;
  box-sizing: border-box;
}
.side-item.on {
  color: #c97a14;
  background: #fffdf6;
  border-left-color: #c97a14;
}

/* 右侧结果 */
.main {
  flex: 1;
  height: 100%;
  box-sizing: border-box;
  padding: 0 calc(20 * var(--u));
}

.grp {
  display: flex;
  align-items: center;
  gap: calc(10 * var(--u));
  padding: calc(22 * var(--u)) calc(4 * var(--u)) calc(12 * var(--u));
}
.grp-name {
  font-size: calc(22 * var(--u));
  font-weight: 800;
  color: #2c3e50;
  letter-spacing: calc(1 * var(--u));
}
/* 部分安卓机 flex 的 gap 不生效，这里再用 margin 兜一层，徽标不会贴着标题 */
.grp-num {
  margin-left: calc(12 * var(--u));
  font-size: calc(18 * var(--u));
  font-weight: 800;
  color: #c97a14;
  background: #fff3d6;
  border: calc(2 * var(--u)) solid #e8c98a;
  border-radius: calc(16 * var(--u));
  padding: calc(1 * var(--u)) calc(10 * var(--u));
  letter-spacing: 0;
}

/* 百科条目 */
.bk-item {
  background: #fffdf6;
  border: calc(3 * var(--u)) solid #2c3e50;
  border-radius: calc(8 * var(--u));
  padding: calc(16 * var(--u)) calc(18 * var(--u));
  margin-bottom: calc(14 * var(--u));
  box-shadow: 0 calc(5 * var(--u)) 0 rgba(44, 62, 80, 0.14);
}
.bk-item-hover {
  transform: translateY(calc(3 * var(--u)));
  box-shadow: 0 calc(2 * var(--u)) 0 rgba(44, 62, 80, 0.14);
}
.bk-top {
  display: flex;
  align-items: center;
  gap: calc(8 * var(--u));
}
.bk-name {
  flex: 1;
  font-size: calc(26 * var(--u));
  font-weight: 800;
  line-height: 1.35;
  color: #2c3e50;
}
.bk-arrow {
  flex: none;
  font-size: calc(30 * var(--u));
  color: #b9cfe0;
}
.bk-tags {
  display: flex;
  flex-wrap: wrap;
  gap: calc(8 * var(--u));
  margin-top: calc(10 * var(--u));
}
.bk-tag {
  font-size: calc(18 * var(--u));
  color: #2f8f6b;
  background: #e8f7f0;
  border: calc(2 * var(--u)) solid #a8dbc6;
  border-radius: calc(4 * var(--u));
  padding: calc(2 * var(--u)) calc(10 * var(--u));
}

/* 我的命令 */
.my-item {
  display: flex;
  align-items: center;
  gap: calc(12 * var(--u));
  background: #fffdf6;
  border: calc(3 * var(--u)) solid #2c3e50;
  border-radius: calc(8 * var(--u));
  padding: calc(14 * var(--u)) calc(16 * var(--u));
  margin-bottom: calc(12 * var(--u));
  box-shadow: 0 calc(5 * var(--u)) 0 rgba(44, 62, 80, 0.14);
}
.my-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: calc(6 * var(--u));
}
.my-title {
  font-size: calc(25 * var(--u));
  font-weight: 700;
  color: #2c3e50;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.my-code {
  font-family: Menlo, Consolas, "Courier New", monospace;
  font-size: calc(19 * var(--u));
  color: #7c8fa3;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.my-dev {
  flex: none;
  font-size: calc(18 * var(--u));
  color: #6f8092;
  background: #eef6ff;
  border: calc(2 * var(--u)) solid #c2d4e3;
  border-radius: calc(4 * var(--u));
  padding: calc(2 * var(--u)) calc(10 * var(--u));
}

/* 加载更多 */
.more {
  margin: calc(6 * var(--u)) 0 calc(10 * var(--u));
  padding: calc(26 * var(--u)) 0;
  text-align: center;
  background: #f6fafd;
  border: calc(3 * var(--u)) dashed #cddff0;
  border-radius: calc(8 * var(--u));
}
.more-hover { background: #eaf3fa; }
.more-txt {
  font-size: calc(23 * var(--u));
  font-weight: 700;
  color: #8aa3b8;
  letter-spacing: calc(0.5 * var(--u));
}

/* 空态 */
.hint {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: calc(130 * var(--u)) calc(20 * var(--u));
}
.hint-ico { font-size: calc(62 * var(--u)); opacity: 0.45; }
.hint-txt {
  margin-top: calc(20 * var(--u));
  font-size: calc(25 * var(--u));
  font-weight: 700;
  color: #8a99aa;
  text-align: center;
}
.hint-sub {
  margin-top: calc(10 * var(--u));
  font-size: calc(21 * var(--u));
  color: #a9bccd;
  text-align: center;
}

.main-foot { height: calc(40 * var(--u)); }

/* ---------- 详情浮层 ---------- */
.mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 50;
  display: flex;
  align-items: flex-end;
  background: rgba(20, 32, 44, 0.55);
}
.sheet {
  width: 100%;
  max-width: var(--W);
  margin-left: auto;
  margin-right: auto;
  max-height: 84vh;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  background: #fffdf6;
  border-top: calc(5 * var(--u)) solid #2c3e50;
  border-radius: calc(18 * var(--u)) calc(18 * var(--u)) 0 0;
  padding-bottom: env(safe-area-inset-bottom);
}
.sheet-head {
  flex: none;
  display: flex;
  align-items: flex-start;
  gap: calc(12 * var(--u));
  padding: calc(22 * var(--u)) calc(24 * var(--u)) calc(16 * var(--u));
  border-bottom: calc(3 * var(--u)) dashed #d9e4ee;
}
.sheet-title-box {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: calc(4 * var(--u));
}
.sheet-title {
  font-size: calc(30 * var(--u));
  font-weight: 800;
  line-height: 1.35;
  color: #2c3e50;
}
.sheet-sub { font-size: calc(20 * var(--u)); color: #9fb0c0; }
.sheet-close {
  flex: none;
  width: calc(52 * var(--u));
  height: calc(52 * var(--u));
  line-height: calc(52 * var(--u));
  text-align: center;
  font-size: calc(23 * var(--u));
  color: #7c8fa3;
  background: #eef2f6;
  border-radius: 50%;
}

/* 详情头部的收藏按钮 */
.sheet-ops {
  flex: none;
  display: flex;
  align-items: center;
  gap: calc(10 * var(--u));
}
.fav-btn {
  font-size: calc(20 * var(--u));
  font-weight: 800;
  color: #c97a14;
  background: #fff3d6;
  border: calc(2 * var(--u)) solid #e8c98a;
  border-radius: calc(6 * var(--u));
  padding: calc(4 * var(--u)) calc(14 * var(--u));
}
.fav-btn-on {
  color: #fffdf6;
  background: #c97a14;
  border-color: #c97a14;
}
.sheet-body {
  flex: 1;
  min-height: calc(240 * var(--u));
  max-height: 62vh;
  box-sizing: border-box;
  padding: calc(18 * var(--u)) calc(24 * var(--u));
}

.sheet-tip {
  display: flex;
  gap: calc(10 * var(--u));
  background: #fff8e6;
  border: calc(3 * var(--u)) solid #e8c98a;
  border-radius: calc(8 * var(--u));
  padding: calc(14 * var(--u)) calc(16 * var(--u));
  margin-bottom: calc(20 * var(--u));
}
.sheet-tip-ico { flex: none; font-size: calc(21 * var(--u)); }
.sheet-tip-txt {
  flex: 1;
  font-size: calc(21 * var(--u));
  line-height: 1.62;
  color: #8a6d3b;
}

/* 单厂商块 */
.vd { margin-bottom: calc(20 * var(--u)); }
.vd-head {
  display: flex;
  align-items: center;
  margin-bottom: calc(8 * var(--u));
}
.vd-name {
  font-size: calc(21 * var(--u));
  font-weight: 800;
  letter-spacing: calc(1 * var(--u));
  color: #fffdf6;
  background: #2c3e50;
  border-radius: calc(4 * var(--u));
  padding: calc(3 * var(--u)) calc(16 * var(--u));
}
.vd-copy {
  margin-left: auto;
  font-size: calc(19 * var(--u));
  font-weight: 700;
  color: #c97a14;
  background: #fff3d6;
  border: calc(2 * var(--u)) solid #e8c98a;
  border-radius: calc(4 * var(--u));
  padding: calc(3 * var(--u)) calc(16 * var(--u));
}
.vd-code {
  background: #22303d;
  border-left: calc(6 * var(--u)) solid #7fd6a0;
  border-radius: 0 calc(6 * var(--u)) calc(6 * var(--u)) 0;
  padding: calc(14 * var(--u)) calc(16 * var(--u));
}
.vd-code-txt {
  font-family: Menlo, Consolas, "Courier New", monospace;
  font-size: calc(21 * var(--u));
  line-height: 1.62;
  letter-spacing: calc(0.4 * var(--u));
  color: #a8e6bf;
  white-space: pre-wrap;
  word-break: break-all;
}

/* 逐行渲染：命令行正常色，注释 / 中文说明行灰掉，复制时不会带上 */
.vd-line {
  display: block;
  font-family: Menlo, Consolas, "Courier New", monospace;
  font-size: calc(21 * var(--u));
  line-height: 1.62;
  letter-spacing: calc(0.4 * var(--u));
  color: #a8e6bf;
  white-space: pre-wrap;
  word-break: break-all;
}
.vd-line-note {
  color: #7c93a6;
}

.sheet-foot {
  flex: none;
  padding: calc(14 * var(--u)) calc(24 * var(--u)) calc(24 * var(--u));
  border-top: calc(3 * var(--u)) dashed #d9e4ee;
}
.sheet-btn {
  height: calc(82 * var(--u));
  line-height: calc(82 * var(--u));
  text-align: center;
  font-size: calc(27 * var(--u));
  font-weight: 800;
  color: #2c3e50;
  background: #ffd86b;
  border: calc(4 * var(--u)) solid #2c3e50;
  border-radius: calc(10 * var(--u));
  box-shadow: 0 calc(7 * var(--u)) 0 rgba(44, 62, 80, 0.25);
}
.sheet-btn-hover {
  transform: translateY(calc(4 * var(--u)));
  box-shadow: 0 calc(3 * var(--u)) 0 rgba(44, 62, 80, 0.25);
}
