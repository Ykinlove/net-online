<view class="browse-page theme-{{theme}}" data-theme="{{theme}}" style="--dur:{{dur || 0.28}}s">

  <offline-bar />

  <!-- 顶部：当前资源类型 + 总量 -->
  <view class="head">
    <view class="head-main">
    <text class="head-title">{{title}}</text>
      <text class="head-num">{{libTotal}} {{unit}}</text>
    </view>
    <text class="head-sub">{{catName}} · {{catDesc}}</text>
  </view>

  <!-- 类型切换：命令百科 / 配置模板库（选中蓝底白字 .seg-item.on） -->
  <view class="kind-seg">
    <view
      class="kind-seg-item seg-item {{kind === 'book' ? 'on' : ''}}"
      bindtap="switchKind"
      data-kind="book"
    >命令百科</view>
    <view
      class="kind-seg-item seg-item {{kind === 'tpl' ? 'on' : ''}}"
      bindtap="switchKind"
      data-kind="tpl"
    >配置模板库</view>
  </view>

  <!-- 关键词筛选：在「当前分类（+ 设备）」的结果里再筛一遍 -->
  <view class="bsearch">
    <image class="icon icon-md" src="/images/icons/{{theme || 'light'}}/search.png" mode="aspectFit" />
    <input
      class="input bsearch-input {{focusKey === 'kw' ? 'input-focus' : ''}}"
      value="{{kw}}"
      placeholder="{{kwTip}}"
      placeholder-class="input-placeholder"
      confirm-type="search"
      data-k="kw"
      bindinput="onKwInput"
      bindfocus="onFieldFocus"
      bindblur="onFieldBlur"
      bindconfirm="onKwInput"
    />
    <text wx:if="{{kw}}" class="bsearch-clear" bindtap="clearKw">✕</text>
  </view>

  <!-- 分类切换（选中蓝底白字 .seg-item.on） -->
  <scroll-view class="cats" scroll-x enable-flex>
    <view
      class="cat seg-item {{cat === '' ? 'on' : ''}}"
      bindtap="pickCat"
      data-k=""
    >
      <text class="cat-name">全部</text>
    </view>
    <view
      wx:for="{{cats}}"
      wx:key="key"
      class="cat seg-item {{cat === item.key ? 'on' : ''}}"
      bindtap="pickCat"
      data-k="{{item.key}}"
    >
      <text class="cat-name">{{item.name}}</text>
      <text class="cat-num">{{item.count}}</text>
    </view>
  </scroll-view>

  <!-- 设备筛选：只有百科有 devs 维度，模板没有设备概念（选中蓝底白字 .seg-item.on） -->
  <scroll-view wx:if="{{kind === 'book'}}" class="devs" scroll-x enable-flex>
    <view
      wx:for="{{sideList}}"
      wx:key="v"
      class="dev seg-item {{dev === item.v ? 'on' : ''}}"
      bindtap="pickDev"
      data-v="{{item.v}}"
    >{{item.t}}</view>
  </scroll-view>

  <!-- 条目列表：命令卡白底细边 + 左侧彩色竖条区分设备/厂商 -->
  <scroll-view class="list" scroll-y bindscrolltolower="loadMore">
    <view
      wx:for="{{shown}}"
      wx:key="id"
      class="item cmd-card {{item.vendorClass}}"
      bindtap="openItem"
      data-idx="{{index}}"
      hover-class="item-hover"
    >
      <view class="item-top">
    <text class="item-name"><text wx:for="{{item.titleSegs}}" wx:for-item="seg" wx:key="t" class="{{seg.hl ? 'hl' : ''}}">{{seg.t}}</text></text>
        <text class="item-arrow">›</text>
      </view>
      <view class="item-tags">
        <text
          wx:for="{{item.chips}}"
          wx:for-item="c"
          wx:key="text"
          class="item-tag {{c.cls}}"
        ><text wx:for="{{c.segs}}" wx:for-item="seg" wx:key="t" class="{{seg.hl ? 'hl' : ''}}">{{seg.t}}</text></text>
      </view>
      <text wx:if="{{item.preview}}" class="item-preview">{{item.preview}}</text>
    </view>

    <view wx:if="{{hasMore}}" class="more" bindtap="loadMore">
      <text class="more-txt">{{shown.length}} / {{total}} · 上滑加载更多</text>
    </view>

    <view wx:if="{{!shown.length}}" class="empty">
    <text class="empty-txt">{{emptyText}}</text>
      <text class="empty-sub">{{emptySub}}</text>
    </view>

    <view class="list-foot"></view>
  </scroll-view>

  <!-- 详情浮层 -->
  <view wx:if="{{detail}}" class="mask" bindtap="closeDetail">
    <view class="sheet" catchtap="noop">

      <view class="sheet-head">
        <view class="sheet-title-box">
          <text class="sheet-title">{{detail.title}}</text>
          <text class="sheet-sub">{{detail.sub}}</text>
        </view>
        <view class="sheet-ops">
          <text wx:if="{{detail.favKind}}" class="fav-btn {{detail.faved ? 'fav-btn-on' : ''}}"
            bindtap="toggleFav">{{detail.faved ? '★ 已收藏' : '☆ 收藏'}}</text>
          <text wx:if="{{detail.favKind}}" class="fav-btn" bindtap="shareBtn"
            open-type="share">转发</text>
          <text class="sheet-close" bindtap="closeDetail">✕</text>
        </view>
      </view>

      <scroll-view class="sheet-body" scroll-y>
        <view wx:if="{{detail.tip}}" class="quote sheet-tip">
          <text class="sheet-tip-txt">{{detail.tip}}</text>
        </view>

        <view wx:for="{{detail.blocks}}" wx:key="vendor" class="vd">
          <view class="vd-head">
            <text class="vd-name tag-outline tag-tech">{{item.vendor}}</text>
            <text class="vd-copy" catchtap="copyOne" data-i="{{index}}">复制</text>
          </view>
          <view class="code-block">
            <view class="code-copy {{item.copied ? 'done' : ''}}" catchtap="onCopyCode" data-i="{{index}}">{{item.copied ? '✓' : '复制'}}</view>
            <scroll-view class="code-scroll" scroll-x enable-flex>
              <view class="code-inner">
                <text
                  wx:for="{{item.lines}}"
                  wx:for-item="ln"
                  wx:key="index"
                  class="vd-line {{ln.note ? 'vd-line-note' : ''}}"
                >{{ln.t}}</text>
              </view>
            </scroll-view>
          </view>
        </view>
      </scroll-view>

      <view class="sheet-foot">
        <view class="btn btn-primary sheet-btn" bindtap="copyAll" hover-class="sheet-btn-hover">
          {{detail.copyLabel}}
        </view>
      </view>

    </view>
  </view>
</view>
