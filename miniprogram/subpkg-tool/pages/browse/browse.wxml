<view class="browse-page">

  <!-- 顶部：当前分类 -->
  <view class="head">
    <view class="head-main">
      <text class="head-title">📚 命令百科</text>
      <text class="head-num">{{total}} 条</text>
    </view>
    <text class="head-sub">{{catName}} · {{catDesc}}</text>
  </view>

  <!-- 分类切换 -->
  <scroll-view class="cats" scroll-x enable-flex>
    <view
      class="cat {{cat === '' ? 'on' : ''}}"
      bindtap="pickCat"
      data-k=""
    >
      <text class="cat-name">全部</text>
    </view>
    <view
      wx:for="{{cats}}"
      wx:key="key"
      class="cat {{cat === item.key ? 'on' : ''}}"
      bindtap="pickCat"
      data-k="{{item.key}}"
    >
      <text class="cat-name">{{item.name}}</text>
      <text class="cat-num">{{item.count}}</text>
    </view>
  </scroll-view>

  <!-- 设备筛选 -->
  <scroll-view class="devs" scroll-x enable-flex>
    <view
      wx:for="{{sideList}}"
      wx:key="v"
      class="dev {{dev === item.v ? 'on' : ''}}"
      bindtap="pickDev"
      data-v="{{item.v}}"
    >{{item.t}}</view>
  </scroll-view>

  <!-- 条目列表 -->
  <scroll-view class="list" scroll-y bindscrolltolower="loadMore">
    <view
      wx:for="{{shown}}"
      wx:key="id"
      class="item"
      bindtap="openItem"
      data-idx="{{index}}"
      hover-class="item-hover"
    >
      <view class="item-top">
        <text class="item-name">{{item.name}}</text>
        <text class="item-arrow">›</text>
      </view>
      <view class="item-tags">
        <text
          wx:for="{{item.cmds}}"
          wx:for-item="c"
          wx:key="vendor"
          class="item-tag"
        >{{c.vendor}}</text>
      </view>
    </view>

    <view wx:if="{{hasMore}}" class="more" bindtap="loadMore">
      <text class="more-txt">{{shown.length}} / {{total}} · 上滑加载更多</text>
    </view>

    <view wx:if="{{!shown.length}}" class="empty">
      <text class="empty-ico">📭</text>
      <text class="empty-txt">这个分类下没有「{{devText}}」的条目</text>
      <text class="empty-sub">把设备切回「全部」试试</text>
    </view>

    <view class="list-foot"></view>
  </scroll-view>

  <!-- 详情浮层 -->
  <view wx:if="{{detail}}" class="mask" bindtap="closeDetail">
    <view class="sheet" catchtap="noop">

      <view class="sheet-head">
        <view class="sheet-title-box">
          <text class="sheet-title">{{detail.title}}</text>
          <text class="sheet-sub">{{detail.sub}}</text>
        </view>
        <view class="sheet-ops">
          <text wx:if="{{detail.favKind}}" class="fav-btn {{detail.faved ? 'fav-btn-on' : ''}}"
            bindtap="toggleFav">{{detail.faved ? '★ 已收藏' : '☆ 收藏'}}</text>
          <text wx:if="{{detail.favKind}}" class="fav-btn" bindtap="shareBtn"
            open-type="share">转发</text>
          <text class="sheet-close" bindtap="closeDetail">✕</text>
        </view>
      </view>

      <scroll-view class="sheet-body" scroll-y>
        <view wx:if="{{detail.tip}}" class="sheet-tip">
          <text class="sheet-tip-ico">💡</text>
          <text class="sheet-tip-txt">{{detail.tip}}</text>
        </view>

        <view wx:for="{{detail.blocks}}" wx:key="vendor" class="vd">
          <view class="vd-head">
            <text class="vd-name">{{item.vendor}}</text>
            <text class="vd-copy" catchtap="copyOne" data-i="{{index}}">复制</text>
          </view>
          <view class="vd-code">
            <text
              wx:for="{{item.lines}}"
              wx:for-item="ln"
              wx:key="index"
              class="vd-line {{ln.note ? 'vd-line-note' : ''}}"
            >{{ln.t}}</text>
          </view>
        </view>
      </scroll-view>

      <view class="sheet-foot">
        <view class="sheet-btn" bindtap="copyAll" hover-class="sheet-btn-hover">
          {{detail.blocks.length > 1 ? '复制全部命令' : '复制命令'}}
        </view>
      </view>

    </view>
  </view>
</view>
