/* 资料库浏览页：知识库文档风
   命令卡白底细边 + 左侧厂商彩色竖条（.cmd-card / .vendor-*），
   分类/设备标签选中蓝底白字（.seg-item.on），命令展示为代码块。
   颜色一律 var(--token)，尺寸一律 calc(N * var(--u))（1px 细边框除外）。 */

.browse-page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  background: var(--bg-page);
}

/* ---------- 顶部 ---------- */
.head {
  flex: none;
  padding: calc(26 * var(--u)) calc(28 * var(--u)) calc(16 * var(--u));
}
.head-main {
  display: flex;
  align-items: center;
  gap: calc(14 * var(--u));
}
.head-title {
  font-size: calc(34 * var(--u));
  font-weight: 600;
  color: var(--text-primary);
  letter-spacing: calc(1 * var(--u));
}
.head-num {
  font-size: calc(20 * var(--u));
  font-weight: 600;
  color: var(--primary);
  background: var(--primary-bg);
  border: 1px solid var(--glass-border);
  border-radius: calc(16 * var(--u));
  padding: calc(2 * var(--u)) calc(14 * var(--u));
}
.head-sub {
  display: block;
  margin-top: calc(10 * var(--u));
  font-size: calc(21 * var(--u));
  color: var(--text-tertiary);
  line-height: 1.5;
}

/* ---------- 类型切换（选中态走全局 .seg-item.on） ---------- */
.kind-seg {
  flex: none;
  display: flex;
  gap: calc(10 * var(--u));
  margin: 0 calc(24 * var(--u)) calc(14 * var(--u));
}
.kind-seg-item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  height: calc(74 * var(--u));
  line-height: 1;
  text-align: center;
  padding: 0;
  border-radius: var(--radius-md);
  font-size: calc(25 * var(--u));
  font-weight: 600;
  box-shadow: none;
}

/* ---------- 关键词筛选框：全局 .input + 单色线性放大镜 ---------- */
.bsearch {
  position: relative;
  flex: none;
  height: calc(88 * var(--u));
  margin: 0 calc(24 * var(--u)) calc(12 * var(--u));
}
/* 放大镜是真实 image：绝对定位，避免挤压 input 造成与分类条重叠 */
.bsearch > .icon {
  position: absolute;
  left: calc(22 * var(--u));
  top: 50%;
  transform: translateY(-50%);
  z-index: 1;
}
.bsearch-input {
  width: 100%;
  padding-left: calc(72 * var(--u));
  padding-right: calc(64 * var(--u));
}
.bsearch-clear {
  position: absolute;
  right: calc(20 * var(--u));
  top: 50%;
  transform: translateY(-50%);
  z-index: 1;
  width: calc(40 * var(--u));
  height: calc(40 * var(--u));
  line-height: calc(40 * var(--u));
  text-align: center;
  font-size: calc(20 * var(--u));
  color: var(--text-tertiary);
  background: var(--bg-subtle);
  border-radius: 50%;
}

/* 命中关键词高亮 */
.hl {
  color: var(--primary);
  background: var(--primary-bg);
  border-radius: calc(3 * var(--u));
  padding: 0 calc(2 * var(--u));
}

/* ---------- 分类条（选中态走全局 .seg-item.on） ---------- */
.cats {
  flex: none;
  white-space: nowrap;
  padding: calc(8 * var(--u)) calc(24 * var(--u)) calc(10 * var(--u));
}
.cat {
  display: inline-flex;
  align-items: center;
  gap: calc(8 * var(--u));
  height: calc(60 * var(--u));
  padding: 0 calc(22 * var(--u));
  margin-right: calc(14 * var(--u));
  border-radius: calc(30 * var(--u));
  box-shadow: none;
  vertical-align: middle;
}
.cat-name {
  font-size: calc(23 * var(--u));
  font-weight: 600;
  color: var(--text-primary);
}
.cat-num {
  font-size: calc(18 * var(--u));
  font-weight: 600;
  color: var(--text-tertiary);
}
.cat.on .cat-name,
.cat.on .cat-num { color: var(--text-on-primary); }

/* ---------- 设备条（选中态走全局 .seg-item.on） ---------- */
.devs {
  flex: none;
  white-space: nowrap;
  padding: 0 calc(24 * var(--u)) calc(14 * var(--u));
}
.dev {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: calc(52 * var(--u));
  line-height: 1;
  box-sizing: border-box;
  font-size: calc(20 * var(--u));
  font-weight: 600;
  padding: 0 calc(16 * var(--u));
  margin-right: calc(10 * var(--u));
  border-radius: var(--radius-sm);
  box-shadow: none;
  vertical-align: middle;
}

/* ---------- 列表：命令卡 ---------- */
.list {
  flex: 1;
  min-height: 0;
  box-sizing: border-box;
  padding: 0 calc(24 * var(--u));
}
.item {
  padding: calc(18 * var(--u)) calc(20 * var(--u));
  margin-bottom: calc(16 * var(--u));
}
.item-hover { background: var(--bg-subtle); }
.item-top {
  display: flex;
  align-items: center;
  gap: calc(8 * var(--u));
}
.item-name {
  flex: 1;
  display: block;
  font-size: calc(28 * var(--u));
  font-weight: 600;
  line-height: 1.4;
  color: var(--text-primary);
}
.item-arrow {
  flex: none;
  font-size: calc(30 * var(--u));
  color: var(--text-tertiary);
}
.item-tags {
  display: flex;
  flex-wrap: wrap;
  gap: calc(10 * var(--u));
  margin-top: calc(12 * var(--u));
}
.item-tag {
  font-size: calc(19 * var(--u));
  color: var(--text-secondary);
  background: var(--bg-subtle);
  border: 1px solid var(--glass-border);
  border-radius: var(--radius-sm);
  padding: calc(2 * var(--u)) calc(10 * var(--u));
}
/* 模板的「分类」标签用绿色，跟厂商标签区分开 */
.item-tag-c {
  color: var(--success);
  background: var(--success-bg);
  border-color: var(--success-bg);
}
/* 模板列表下的首行命令预览：等宽代码块 */
.item-preview {
  display: block;
  margin-top: calc(14 * var(--u));
  font-family: var(--font-code);
  font-size: calc(21 * var(--u));
  line-height: 1.5;
  color: var(--code-text);
  background: var(--code-bg);
  border: 1px solid var(--code-border);
  border-radius: var(--radius-sm);
  padding: calc(12 * var(--u)) calc(14 * var(--u));
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 加载更多 / 空态 */
.more {
  text-align: center;
  padding: calc(18 * var(--u)) 0;
}
.more-txt {
  font-size: calc(21 * var(--u));
  color: var(--text-tertiary);
}
.empty {
  padding: calc(80 * var(--u)) calc(40 * var(--u));
  text-align: center;
}
.empty-txt {
  display: block;
  font-size: calc(24 * var(--u));
  color: var(--text-secondary);
}
.empty-sub {
  display: block;
  margin-top: calc(8 * var(--u));
  font-size: calc(21 * var(--u));
  color: var(--text-tertiary);
  line-height: 1.6;
}
.list-foot { height: calc(40 * var(--u)); }

/* ---------- 详情浮层 ---------- */
.mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 50;
  display: flex;
  align-items: flex-end;
  background: var(--mask-bg);
}
.sheet {
  width: 100%;
  max-width: var(--W);
  margin-left: auto;
  margin-right: auto;
  max-height: 84vh;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  background: var(--glass-bg);
  -webkit-backdrop-filter: blur(18px) saturate(160%);
  backdrop-filter: blur(18px) saturate(160%);
  border-top: 1px solid var(--border);
  border-radius: var(--radius-lg) var(--radius-lg) 0 0;
  padding-bottom: env(safe-area-inset-bottom);
}
.sheet-head {
  flex: none;
  display: flex;
  align-items: flex-start;
  gap: calc(12 * var(--u));
  padding: calc(22 * var(--u)) calc(24 * var(--u)) calc(16 * var(--u));
  border-bottom: 1px solid var(--border);
}
.sheet-title-box {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: calc(4 * var(--u));
}
.sheet-title {
  font-size: calc(30 * var(--u));
  font-weight: 600;
  line-height: 1.35;
  color: var(--text-primary);
}
.sheet-sub { font-size: calc(20 * var(--u)); color: var(--text-tertiary); }
.sheet-close {
  flex: none;
  width: calc(52 * var(--u));
  height: calc(52 * var(--u));
  line-height: calc(52 * var(--u));
  text-align: center;
  font-size: calc(23 * var(--u));
  color: var(--text-tertiary);
  background: var(--bg-subtle);
  border-radius: 50%;
}
.sheet-ops {
  flex: none;
  display: flex;
  align-items: center;
  gap: calc(10 * var(--u));
}
.fav-btn {
  font-size: calc(20 * var(--u));
  font-weight: 500;
  color: var(--primary);
  background: var(--primary-bg);
  border: 1px solid var(--glass-border);
  border-radius: var(--radius-sm);
  padding: calc(4 * var(--u)) calc(14 * var(--u));
}
.fav-btn-on {
  color: var(--text-on-primary);
  background: var(--primary);
  border-color: var(--primary);
}
.sheet-body {
  flex: 1;
  min-height: calc(240 * var(--u));
  max-height: 62vh;
  box-sizing: border-box;
  padding: calc(18 * var(--u)) calc(24 * var(--u));
}
.sheet-tip { margin-bottom: calc(20 * var(--u)); }
.sheet-tip-txt {
  font-size: calc(21 * var(--u));
  line-height: 1.62;
  color: var(--text-secondary);
}

/* 单厂商块：厂商名描边标签 + 代码块 */
.vd { margin-bottom: calc(20 * var(--u)); }
.vd-head {
  display: flex;
  align-items: center;
  margin-bottom: calc(8 * var(--u));
}
.vd-copy {
  margin-left: auto;
  font-size: calc(19 * var(--u));
  color: var(--primary);
  background: var(--primary-bg);
  border: 1px solid var(--glass-border);
  border-radius: var(--radius-sm);
  padding: calc(3 * var(--u)) calc(16 * var(--u));
}
.code-block {
  overflow: hidden;
  padding-top: calc(52 * var(--u));
}
.code-scroll { width: 100%; }
.code-inner {
  display: inline-block;
  min-width: 100%;
  white-space: pre;
}
.vd-line {
  display: block;
  font-family: var(--font-code);
  font-size: calc(22 * var(--u));
  line-height: 1.7;
  color: var(--code-text);
  white-space: pre;
}
.vd-line-note { color: var(--text-tertiary); }

/* 主按钮 .btn-primary */
.sheet-foot {
  flex: none;
  padding: calc(14 * var(--u)) calc(24 * var(--u)) calc(24 * var(--u));
  border-top: 1px solid var(--border);
}
.sheet-btn {
  width: 100%;
  height: calc(82 * var(--u));
  border-radius: var(--radius-md);
}
.sheet-btn-hover { opacity: 0.86; }
