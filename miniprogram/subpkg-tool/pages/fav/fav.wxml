<view class="fav-page theme-{{theme}}" data-theme="{{theme}}" style="--dur:{{dur || 0.28}}s">

  <offline-bar />

  <!-- 顶部 -->
  <view class="head">
    <view class="head-main">
    <text class="head-title">我的收藏</text>
      <text class="head-num">{{total}} 条</text>
    </view>
    <text class="head-sub">百科条目 / 配置模板 / 自己记的命令，都在这儿，跟着档案同步</text>
  </view>

  <!-- 搜索：在收藏里按标题 / 副标题 / 类型找 -->
  <view class="fsearch">
    <image class="icon icon-md" src="/images/icons/{{theme || 'light'}}/search.png" mode="aspectFit" />
    <input
      class="input fsearch-input {{focusKey === 'kw' ? 'input-focus' : ''}}"
      value="{{kw}}"
      placeholder="在收藏里搜，比如「vlan」「开局」"
      placeholder-class="input-placeholder"
      confirm-type="search"
      data-k="kw"
      bindinput="onKwInput"
      bindfocus="onFieldFocus"
      bindblur="onFieldBlur"
      bindconfirm="onKwInput"
    />
    <text wx:if="{{kw}}" class="fsearch-clear" bindtap="clearKw">✕</text>
  </view>

  <!-- 类型切换（选中蓝底白字 .seg-item.on） -->
  <view class="tabs">
    <view
      wx:for="{{tabs}}"
      wx:key="k"
      class="tab seg-item {{tab === item.k ? 'on' : ''}}"
      bindtap="pickTab"
      data-k="{{item.k}}"
    >
      <text class="tab-name">{{item.name}}</text>
      <text class="tab-num">{{item.n}}</text>
    </view>
  </view>

  <!-- 收藏列表：去外框改底部分割线（.list-item） -->
  <scroll-view class="list" scroll-y>
    <view
      wx:for="{{list}}"
      wx:key="kindId"
      class="item list-item"
      bindtap="openItem"
      data-idx="{{index}}"
      hover-class="item-hover"
    >
      <view class="item-main">
        <view class="item-head">
          <text class="item-kind tag-outline tag-tech">{{item.kindName}}</text>
          <text class="item-title"><text wx:for="{{item.titleSegs}}" wx:for-item="seg" wx:key="t" class="{{seg.hl ? 'hl' : ''}}">{{seg.t}}</text></text>
        </view>
        <text wx:if="{{item.sub}}" class="item-sub"><text wx:for="{{item.subSegs}}" wx:for-item="seg" wx:key="t" class="{{seg.hl ? 'hl' : ''}}">{{seg.t}}</text></text>
      </view>
      <view class="item-ops">
        <text class="item-del" catchtap="removeFav" data-idx="{{index}}">取消</text>
        <text class="item-arrow">›</text>
      </view>
    </view>

    <view wx:if="{{!list.length}}" class="empty">
    <text class="empty-txt">{{kw ? '没找到匹配「' + kw + '」的收藏' : '这里还是空的'}}</text>
      <text class="empty-sub">{{kw ? '换个关键词，或把上方标签切到「全部」' : '在搜索结果或百科条目里点「收藏」，就会出现在这儿'}}</text>
    </view>

    <view class="list-foot"></view>
  </scroll-view>

  <!-- 详情浮层 -->
  <view wx:if="{{detail}}" class="mask" bindtap="closeDetail">
    <view class="sheet" catchtap="noop">

      <view class="sheet-head">
        <view class="sheet-title-box">
          <text class="sheet-title">{{detail.title}}</text>
          <text class="sheet-sub">{{detail.sub}}</text>
        </view>
        <text class="sheet-close" bindtap="closeDetail">✕</text>
      </view>

      <scroll-view class="sheet-body" scroll-y>
        <view wx:if="{{detail.tip}}" class="quote sheet-tip">
          <text class="sheet-tip-txt">{{detail.tip}}</text>
        </view>

        <view wx:for="{{detail.blocks}}" wx:key="vendor" class="vd">
          <view class="vd-head">
            <text class="vd-name tag-outline tag-tech">{{item.vendor}}</text>
            <text class="vd-copy" catchtap="copyOne" data-i="{{index}}">复制</text>
          </view>
          <view class="code-block">
            <view class="code-copy {{item.copied ? 'done' : ''}}" catchtap="onCopyCode" data-i="{{index}}">{{item.copied ? '✓' : '复制'}}</view>
            <scroll-view class="code-scroll" scroll-x enable-flex>
              <view class="code-inner">
                <text
                  wx:for="{{item.lines}}"
                  wx:for-item="ln"
                  wx:key="index"
                  class="vd-line {{ln.note ? 'vd-line-note' : ''}}"
                >{{ln.t}}</text>
              </view>
            </scroll-view>
          </view>
        </view>
      </scroll-view>

      <view class="sheet-foot">
        <view class="btn btn-primary sheet-btn" bindtap="copyAll" hover-class="sheet-btn-hover">
          {{detail.blocks.length > 1 ? '复制全部命令' : '复制命令'}}
        </view>
      </view>

    </view>
  </view>
</view>
