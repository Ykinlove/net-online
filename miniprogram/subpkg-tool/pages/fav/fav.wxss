/* 收藏页：知识库文档风 —— 列表分割线式，命令展示为代码块。
   颜色一律 var(--token)，尺寸一律 calc(N * var(--u))（1px 细边框除外）。 */

.fav-page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  background: var(--bg-page);
}

/* ---------- 顶部 ---------- */
.head {
  flex: none;
  padding: calc(26 * var(--u)) calc(28 * var(--u)) calc(16 * var(--u));
}
.head-main {
  display: flex;
  align-items: center;
  gap: calc(14 * var(--u));
}
.head-title {
  font-size: calc(34 * var(--u));
  font-weight: 600;
  color: var(--text-primary);
  letter-spacing: calc(1 * var(--u));
}
.head-num {
  font-size: calc(20 * var(--u));
  font-weight: 600;
  color: var(--primary);
  background: var(--primary-bg);
  border: 1px solid var(--glass-border);
  border-radius: calc(16 * var(--u));
  padding: calc(2 * var(--u)) calc(14 * var(--u));
}
.head-sub {
  display: block;
  margin-top: calc(10 * var(--u));
  font-size: calc(21 * var(--u));
  color: var(--text-tertiary);
  line-height: 1.5;
}

/* ---------- 搜索框：全局 .input + 单色线性放大镜 ---------- */
.fsearch {
  position: relative;
  flex: none;
  height: calc(88 * var(--u));
  margin: 0 calc(28 * var(--u)) calc(12 * var(--u));
}
/* 放大镜是真实 image：必须绝对定位，否则它会占一行把 input 挤到容器外，
   造成搜索框和下方标签/列表重叠 */
.fsearch > .icon {
  position: absolute;
  left: calc(22 * var(--u));
  top: 50%;
  transform: translateY(-50%);
  z-index: 1;
}
.fsearch-input {
  width: 100%;
  padding-left: calc(72 * var(--u));
  padding-right: calc(64 * var(--u));
}
.fsearch-clear {
  position: absolute;
  right: calc(20 * var(--u));
  top: 50%;
  transform: translateY(-50%);
  z-index: 1;
  width: calc(40 * var(--u));
  height: calc(40 * var(--u));
  line-height: calc(40 * var(--u));
  text-align: center;
  font-size: calc(20 * var(--u));
  color: var(--text-tertiary);
  background: var(--bg-subtle);
  border-radius: 50%;
}

/* 命中关键词高亮 */
.hl {
  color: var(--primary);
  background: var(--primary-bg);
  border-radius: calc(3 * var(--u));
  padding: 0 calc(2 * var(--u));
}

/* ---------- 类型切换（选中态走全局 .seg-item.on） ---------- */
.tabs {
  flex: none;
  display: flex;
  gap: calc(12 * var(--u));
  padding: 0 calc(28 * var(--u)) calc(16 * var(--u));
}
.tab {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: calc(88 * var(--u));
  box-sizing: border-box;
  line-height: 1;
  gap: calc(6 * var(--u));
  padding: calc(12 * var(--u)) 0;
  border-radius: var(--radius-md);
  box-shadow: none;
}
.tab-name {
  font-size: calc(22 * var(--u));
  font-weight: 600;
  color: var(--text-primary);
}
.tab-num {
  font-size: calc(18 * var(--u));
  font-weight: 600;
  color: var(--text-tertiary);
}
.tab.on .tab-name,
.tab.on .tab-num { color: var(--text-on-primary); }

/* ---------- 列表：去外框改底部分割线（全局 .list-item） ---------- */
.list {
  flex: 1;
  min-height: 0;
  box-sizing: border-box;
  padding: 0 calc(24 * var(--u));
}
.item {
  display: flex;
  align-items: center;
  gap: calc(12 * var(--u));
}
.item-hover { background: var(--bg-subtle); }
.item-main {
  flex: 1;
  min-width: 0;
}
.item-head {
  display: flex;
  align-items: baseline;
  gap: calc(8 * var(--u));
}
.item-title {
  flex: 1;
  min-width: 0;
  font-size: calc(25 * var(--u));
  font-weight: 600;
  line-height: 1.35;
  color: var(--text-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.item-sub {
  display: block;
  margin-top: calc(6 * var(--u));
  font-size: calc(19 * var(--u));
  color: var(--text-tertiary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.item-ops {
  flex: none;
  display: flex;
  align-items: center;
  gap: calc(12 * var(--u));
}
/* 取消收藏：危险按钮，--danger 描边 */
.item-del {
  font-size: calc(19 * var(--u));
  color: var(--danger);
  background: var(--glass-bg);
  -webkit-backdrop-filter: blur(18px) saturate(160%);
  backdrop-filter: blur(18px) saturate(160%);
  border: 1px solid var(--danger);
  border-radius: var(--radius-sm);
  padding: calc(3 * var(--u)) calc(12 * var(--u));
}
.item-arrow {
  font-size: calc(30 * var(--u));
  color: var(--text-tertiary);
}

/* 空态：纯色几何图形替代 emoji 插画 */
.empty {
  padding: calc(90 * var(--u)) calc(40 * var(--u));
  text-align: center;
}
.empty-txt {
  display: block;
  font-size: calc(24 * var(--u));
  color: var(--text-secondary);
}
.empty-sub {
  display: block;
  margin-top: calc(8 * var(--u));
  font-size: calc(21 * var(--u));
  color: var(--text-tertiary);
  line-height: 1.6;
}
.list-foot { height: calc(40 * var(--u)); }

/* ---------- 详情浮层 ---------- */
.mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 50;
  display: flex;
  align-items: flex-end;
  background: var(--mask-bg);
}
.sheet {
  width: 100%;
  max-width: var(--W);
  margin-left: auto;
  margin-right: auto;
  max-height: 84vh;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  background: var(--glass-bg);
  -webkit-backdrop-filter: blur(18px) saturate(160%);
  backdrop-filter: blur(18px) saturate(160%);
  border-top: 1px solid var(--border);
  border-radius: var(--radius-lg) var(--radius-lg) 0 0;
  padding-bottom: env(safe-area-inset-bottom);
}
.sheet-head {
  flex: none;
  display: flex;
  align-items: flex-start;
  gap: calc(12 * var(--u));
  padding: calc(22 * var(--u)) calc(24 * var(--u)) calc(16 * var(--u));
  border-bottom: 1px solid var(--border);
}
.sheet-title-box {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: calc(4 * var(--u));
}
.sheet-title {
  font-size: calc(30 * var(--u));
  font-weight: 600;
  line-height: 1.35;
  color: var(--text-primary);
}
.sheet-sub { font-size: calc(20 * var(--u)); color: var(--text-tertiary); }
.sheet-close {
  flex: none;
  width: calc(52 * var(--u));
  height: calc(52 * var(--u));
  line-height: calc(52 * var(--u));
  text-align: center;
  font-size: calc(23 * var(--u));
  color: var(--text-tertiary);
  background: var(--bg-subtle);
  border-radius: 50%;
}
.sheet-body {
  flex: 1;
  min-height: calc(240 * var(--u));
  max-height: 62vh;
  box-sizing: border-box;
  padding: calc(18 * var(--u)) calc(24 * var(--u));
}
.sheet-tip { margin-bottom: calc(20 * var(--u)); }
.sheet-tip-txt {
  font-size: calc(21 * var(--u));
  line-height: 1.62;
  color: var(--text-secondary);
}

/* 单厂商块：厂商名描边标签 + 代码块 */
.vd { margin-bottom: calc(20 * var(--u)); }
.vd-head {
  display: flex;
  align-items: center;
  margin-bottom: calc(8 * var(--u));
}
.vd-copy {
  margin-left: auto;
  font-size: calc(19 * var(--u));
  color: var(--primary);
  background: var(--primary-bg);
  border: 1px solid var(--glass-border);
  border-radius: var(--radius-sm);
  padding: calc(3 * var(--u)) calc(16 * var(--u));
}
.code-block {
  overflow: hidden;
  padding-top: calc(52 * var(--u));
}
.code-scroll { width: 100%; }
.code-inner {
  display: inline-block;
  min-width: 100%;
  white-space: pre;
}
.vd-line {
  display: block;
  font-family: var(--font-code);
  font-size: calc(22 * var(--u));
  line-height: 1.7;
  color: var(--code-text);
  white-space: pre;
}
.vd-line-note { color: var(--text-tertiary); }

/* 主按钮 .btn-primary */
.sheet-foot {
  flex: none;
  padding: calc(14 * var(--u)) calc(24 * var(--u)) calc(24 * var(--u));
  border-top: 1px solid var(--border);
}
.sheet-btn {
  width: 100%;
  height: calc(82 * var(--u));
  border-radius: var(--radius-md);
}
.sheet-btn-hover { opacity: 0.86; }
