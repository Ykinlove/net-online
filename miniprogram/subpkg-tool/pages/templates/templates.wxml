<view class="tpl-page">

  <!-- 顶部说明 -->
  <view class="head">
    <view class="head-main">
      <text class="head-title">📋 配置模板</text>
      <text class="head-num">{{total}} 个</text>
    </view>
    <text class="head-sub">开局 / 排障直接套，复制后把 &lt;尖括号&gt; 换成你的参数</text>
  </view>

  <!-- 分类切换 -->
  <scroll-view class="cats" scroll-x enable-flex>
    <view
      wx:for="{{cats}}"
      wx:key="*this"
      class="cat {{cat === item ? 'on' : ''}}"
      bindtap="pickCat"
      data-v="{{item}}"
    >
      <text class="cat-name">{{item}}</text>
      <text class="cat-num">{{catCount[item] || 0}}</text>
    </view>
  </scroll-view>

  <!-- 模板列表 -->
  <scroll-view class="list" scroll-y>
    <view
      wx:for="{{shown}}"
      wx:key="id"
      class="tpl-item"
      bindtap="openTpl"
      data-id="{{item.id}}"
      hover-class="tpl-item-hover"
    >
      <view class="tpl-top">
        <text class="tpl-name">{{item.name}}</text>
        <text class="tpl-arrow">›</text>
      </view>
      <view class="tpl-tags">
        <text class="tpl-tag tpl-tag-v">{{item.vendor}}</text>
        <text class="tpl-tag tpl-tag-c">{{item.cat}}</text>
      </view>
      <text class="tpl-code">{{item.preview}}</text>
    </view>

    <view class="list-foot"></view>
  </scroll-view>

  <!-- 详情浮层 -->
  <view wx:if="{{detail}}" class="mask" bindtap="closeDetail">
    <view class="sheet" catchtap="noop">

      <view class="sheet-head">
        <view class="sheet-title-box">
          <text class="sheet-title">{{detail.title}}</text>
          <text class="sheet-sub">{{detail.sub}}</text>
        </view>
        <text class="sheet-close" bindtap="closeDetail">✕</text>
      </view>

      <scroll-view class="sheet-body" scroll-y>
        <view wx:if="{{detail.tip}}" class="sheet-tip">
          <text class="sheet-tip-ico">💡</text>
          <text class="sheet-tip-txt">{{detail.tip}}</text>
        </view>

        <view class="vd">
          <view class="vd-head">
            <text class="vd-name">{{detail.sub}}</text>
            <text class="vd-copy" catchtap="copyTpl">复制</text>
          </view>
          <view class="vd-code">
            <text
              wx:for="{{detail.lines}}"
              wx:for-item="ln"
              wx:key="index"
              class="vd-line {{ln.note ? 'vd-line-note' : ''}}"
            >{{ln.t}}</text>
          </view>
        </view>
      </scroll-view>

      <view class="sheet-foot">
        <view class="sheet-btn" bindtap="copyTpl" hover-class="sheet-btn-hover">复制模板命令</view>
      </view>

    </view>
  </view>
</view>
