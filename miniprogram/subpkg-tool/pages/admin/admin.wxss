/* pages/admin/admin.wxss
   复用全局卡片 / 表单 / 代码块系统，仅补充 admin 专属布局。
   全部颜色走 var(--token)，1px 细边 + 轻阴影，无字面色值、无渐变重阴影。 */

/* ---------- 口令锁 ---------- */
.lock-wrap {
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
}
.lock-card {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  padding: calc(48 * var(--u)) calc(32 * var(--u));
}
.lock-badge {
  width: calc(120 * var(--u));
  height: calc(120 * var(--u));
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: calc(24 * var(--u));
  background: var(--primary-bg);
  border: 1px solid var(--glass-border);
  border-radius: 50%;
}
/* 纯 CSS 线性锁（蓝色 --primary），仅在此放大 */
.lock-badge .icon-lock { transform: scale(2.2); }
.lock-title { font-size: calc(36 * var(--u)); font-weight: 600; color: var(--text-primary); margin-bottom: calc(12 * var(--u)); }
.lock-sub { font-size: calc(24 * var(--u)); color: var(--text-secondary); line-height: 1.6; margin-bottom: calc(40 * var(--u)); }
.lock-input { text-align: center; margin-bottom: calc(28 * var(--u)); }
.lock-btn { margin-bottom: calc(28 * var(--u)); }
.hint { font-size: calc(21 * var(--u)); color: var(--text-tertiary); line-height: 1.6; }

/* ---------- 头部 ---------- */
.head-card { padding: calc(20 * var(--u)) calc(24 * var(--u)); }
.head-row { display: flex; align-items: center; }
.head-row .card-title { margin: 0; }
.logout { margin-left: auto; font-size: calc(25 * var(--u)); font-weight: 500; color: var(--primary); }
.head-sub { display: block; font-size: calc(23 * var(--u)); color: var(--text-secondary); margin-top: calc(10 * var(--u)); }

/* ---------- 定位 ---------- */
.locate { display: flex; align-items: center; gap: calc(16 * var(--u)); }
.locate-input { flex: 1; }
.locate-btn { flex-shrink: 0; }

/* ---------- 身份卡 ---------- */
.id-row { display: flex; align-items: center; gap: calc(14 * var(--u)); }
.id-badge {
  display: inline-flex; align-items: center; justify-content: center;
  padding: calc(6 * var(--u)) calc(18 * var(--u));
  font-size: calc(22 * var(--u)); font-weight: 500;
  border: 1px solid var(--glass-border);
  border-radius: var(--radius-sm);
}
.badge-book { background: var(--primary-bg); color: var(--primary); border-color: var(--border); }
.badge-tpl { background: var(--primary-bg); color: var(--primary); border-color: var(--primary); }
.id-text { font-size: calc(25 * var(--u)); color: var(--text-primary); font-weight: 500; word-break: break-all; }
.warn {
  margin-top: calc(16 * var(--u));
  font-size: calc(22 * var(--u)); color: var(--warning);
  background: var(--warning-bg); border: 1px solid var(--glass-border);
  border-radius: var(--radius-sm); padding: calc(12 * var(--u)) calc(16 * var(--u)); line-height: 1.5;
}

/* ---------- 厂商命令：分割线式列表项 ---------- */
.vendor-card { display: flex; flex-direction: column; }
.vendor-head { margin-bottom: calc(10 * var(--u)); }
.vendor-name {
  font-size: calc(25 * var(--u)); font-weight: 500; color: var(--primary);
}
.vendor-code { min-height: calc(200 * var(--u)); }

/* ---------- 代码块：等宽 / 横滚 / 右上角复制 ---------- */
.code-cap {
  display: block;
  font-size: calc(21 * var(--u));
  color: var(--text-tertiary);
  margin: calc(14 * var(--u)) 0 calc(8 * var(--u));
}
.cmd-codeblock {
  overflow: visible;
  padding-top: calc(52 * var(--u));
  margin-bottom: calc(8 * var(--u));
}
.cmd-codeblock .code-scroll { width: 100%; }
.cmd-codeblock .dt-code {
  display: inline-block;
  font-family: var(--font-code);
  font-size: calc(23 * var(--u));
  line-height: 1.7;
  color: var(--code-text);
  white-space: pre;
}

/* ---------- 状态提示 ---------- */
.ok {
  margin-top: calc(20 * var(--u));
  font-size: calc(24 * var(--u)); color: var(--success); font-weight: 500;
  background: var(--success-bg); border: 1px solid var(--glass-border);
  border-radius: var(--radius-sm); padding: calc(14 * var(--u)) calc(18 * var(--u));
  text-align: center;
}
.err {
  margin-top: calc(18 * var(--u));
  font-size: calc(24 * var(--u)); color: var(--danger); font-weight: 500;
  background: var(--danger-bg); border: 1px solid var(--glass-border);
  border-radius: var(--radius-sm); padding: calc(14 * var(--u)) calc(18 * var(--u));
}
.load-pad { padding: calc(20 * var(--u)) 0; }

/* ---------- 主功能 tab ---------- */
.tab-seg { margin-bottom: calc(22 * var(--u)); }

/* ---------- 待审核：分割线式列表项 ---------- */
.review-card { display: flex; flex-direction: column; }
.review-head { display: flex; align-items: center; gap: calc(12 * var(--u)); flex-wrap: wrap; }
.review-type {
  font-size: calc(21 * var(--u)); font-weight: 500; color: var(--text-secondary);
  background: transparent; border: 1px solid var(--border-strong);
  border-radius: var(--radius-sm); padding: calc(3 * var(--u)) calc(12 * var(--u));
}
.review-title { font-size: calc(27 * var(--u)); font-weight: 500; color: var(--text-primary); }
.review-target { font-size: calc(22 * var(--u)); color: var(--text-secondary); margin-top: calc(8 * var(--u)); }
.review-summary {
  display: block;
  font-size: calc(23 * var(--u)); color: var(--text-secondary); line-height: 1.6;
  margin-top: calc(12 * var(--u));
  white-space: pre-wrap;
  background: var(--bg-subtle); border: 1px solid var(--glass-border);
  border-radius: var(--radius-sm); padding: calc(12 * var(--u)) calc(14 * var(--u));
}
.review-actions { display: flex; gap: calc(16 * var(--u)); margin-top: calc(16 * var(--u)); }
.review-ok { flex: 1; }
.review-no { flex: 1; }
