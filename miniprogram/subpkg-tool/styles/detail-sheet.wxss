/* subpkg-tool/styles/detail-sheet.wxss —— 命令详情浮层共享样式
   search / browse / fav 三页原本各复制了一份逐字相同的规则（约 120 行）。
   现统一到这一处；改动这里会同时影响三页，务必跑
     python miniprogram-tools/css_snapshot.py --check
   确认最终层叠结果没变。
   .sheet-ops / .fav-btn / .fav-btn-on 只有 search/browse 用，另放
   sheet-ops.wxss，fav 不引入（避免给 fav 多出三个无用选择器）。 */

/* ---------- 详情浮层 ---------- */
.mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 50;
  display: flex;
  align-items: flex-end;
  background: var(--mask-bg);
}
.sheet {
  width: 100%;
  max-width: var(--W);
  margin-left: auto;
  margin-right: auto;
  max-height: 84vh;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  background: var(--glass-bg);
  -webkit-backdrop-filter: blur(18px) saturate(160%);
  backdrop-filter: blur(18px) saturate(160%);
  border-top: 1px solid var(--border);
  border-radius: var(--radius-lg) var(--radius-lg) 0 0;
  padding-bottom: env(safe-area-inset-bottom);
}
.sheet-head {
  flex: none;
  display: flex;
  align-items: flex-start;
  gap: calc(12 * var(--u));
  padding: calc(22 * var(--u)) calc(24 * var(--u)) calc(16 * var(--u));
  border-bottom: 1px solid var(--border);
}
.sheet-title-box {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: calc(4 * var(--u));
}
.sheet-title {
  font-size: calc(30 * var(--u));
  font-weight: 600;
  line-height: 1.35;
  color: var(--text-primary);
}
.sheet-sub { font-size: calc(20 * var(--u)); color: var(--text-tertiary); }
.sheet-close {
  flex: none;
  width: calc(52 * var(--u));
  height: calc(52 * var(--u));
  line-height: calc(52 * var(--u));
  text-align: center;
  font-size: calc(23 * var(--u));
  color: var(--text-tertiary);
  background: var(--bg-subtle);
  border-radius: 50%;
}
.sheet-body {
  flex: 1;
  min-height: calc(240 * var(--u));
  max-height: 62vh;
  box-sizing: border-box;
  padding: calc(18 * var(--u)) calc(24 * var(--u));
}
.sheet-tip { margin-bottom: calc(20 * var(--u)); }
.sheet-tip-txt {
  font-size: calc(21 * var(--u));
  line-height: 1.62;
  color: var(--text-secondary);
}

/* 单厂商块：厂商名描边标签 + 代码块 */
.vd { margin-bottom: calc(20 * var(--u)); }
.vd-head {
  display: flex;
  align-items: center;
  margin-bottom: calc(8 * var(--u));
}
.vd-copy {
  margin-left: auto;
  font-size: calc(19 * var(--u));
  color: var(--primary);
  background: var(--primary-bg);
  border: 1px solid var(--glass-border);
  border-radius: var(--radius-sm);
  padding: calc(3 * var(--u)) calc(16 * var(--u));
}
.code-block {
  overflow: hidden;
  padding-top: calc(52 * var(--u));
}
.code-scroll { width: 100%; }
.code-inner {
  display: inline-block;
  min-width: 100%;
  white-space: pre;
}
.vd-line {
  display: block;
  font-family: var(--font-code);
  font-size: calc(22 * var(--u));
  line-height: 1.7;
  color: var(--code-text);
  white-space: pre;
}
.vd-line-note { color: var(--text-tertiary); }

/* 主按钮 .btn-primary */
.sheet-foot {
  flex: none;
  padding: calc(14 * var(--u)) calc(24 * var(--u)) calc(24 * var(--u));
  border-top: 1px solid var(--border);
}
.sheet-btn {
  width: 100%;
  height: calc(82 * var(--u));
  border-radius: var(--radius-md);
}
.sheet-btn-hover { opacity: 0.86; }
