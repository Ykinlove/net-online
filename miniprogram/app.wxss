/* ============================================================
   app.wxss —— 知识库文档风 / 全局 Design Token
   ------------------------------------------------------------
   尺寸体系沿用方案 B：全站尺寸仍写 calc(N * var(--u))，
   --u / --W 的响应式计算不可改动，否则全站布局会崩。

   主题优先级（从低到高）：
     1. :root / page           浅色默认
     2. @media(prefers-color-scheme:dark)  系统深色
     3. .theme-dark  / [data-theme="dark"]   手动深色
        .theme-light / [data-theme="light"]  手动浅色
   注意：WXSS 的 prefers-color-scheme 不受 app.json darkmode 开关
   控制，系统深色时它一定生效，所以「手动浅色」必须显式覆盖回
   浅色值；属性选择器在 Skyline 不支持，因此同时提供等价类选择器，
   且两者分开书写，避免无效选择器连累整条规则。
   ============================================================ */

/* ---------- 1. 浅色默认值（:root） ---------- */
:root {
  --bg-page: #F7F8FA;
  --bg-card: #FFFFFF;
  --bg-subtle: #F3F5F7;
  --border: #EBEEF2;
  --border-strong: #D6DBE3;
  --divider: #EDF0F4;
  --text-primary: #1A1D24;
  --text-secondary: #5F6672;
  --text-tertiary: #9AA1AD;
  --text-on-primary: #FFFFFF;
  --primary: #3B7DD8;
  --primary-hover: #2F6BBF;
  --primary-bg: #EDF3FB;
  --success: #2E9E6B;
  --success-bg: #E9F6EF;
  --warning: #D98A34;
  --warning-bg: #FBF2E6;
  --danger: #D64545;
  --danger-bg: #FBEEEE;
  /* 代码块不用绿字：浅灰底 + 深蓝灰字，深色下反过来，两套都保证足够对比度 */
  --code-bg: #F2F5F9;
  --code-text: #2F3A4A;
  --code-border: #DEE5EE;
  --shadow-card: 0 1px 3px rgba(26, 29, 36, 0.05);
  --shadow-soft: 0 1px 2px rgba(26, 29, 36, 0.06);
  --mask-bg: rgba(18, 20, 26, 0.55);
  --radius-lg: 12px;
  --radius-md: 8px;
  --radius-sm: 6px;
  --font-code: Consolas, "Courier New", monospace;
}

/* ---------- 2. 浅色默认值（page，小程序实际根） ---------- */
page {
  /* = 100vw ÷ 750，用乘法兼容所有内核 */
  --u: calc(100vw * 0.0013333333);
  --W: 100vw;
  --bg-page: #F7F8FA;
  --bg-card: #FFFFFF;
  --bg-subtle: #F3F5F7;
  --border: #EBEEF2;
  --border-strong: #D6DBE3;
  --divider: #EDF0F4;
  --text-primary: #1A1D24;
  --text-secondary: #5F6672;
  --text-tertiary: #9AA1AD;
  --text-on-primary: #FFFFFF;
  --primary: #3B7DD8;
  --primary-hover: #2F6BBF;
  --primary-bg: #EDF3FB;
  --success: #2E9E6B;
  --success-bg: #E9F6EF;
  --warning: #D98A34;
  --warning-bg: #FBF2E6;
  --danger: #D64545;
  --danger-bg: #FBEEEE;
  --code-bg: #F2F5F9;
  --code-text: #2F3A4A;
  --code-border: #DEE5EE;
  --shadow-card: 0 1px 3px rgba(26, 29, 36, 0.05);
  --shadow-soft: 0 1px 2px rgba(26, 29, 36, 0.06);
  --mask-bg: rgba(18, 20, 26, 0.55);
  --radius-lg: 12px;
  --radius-md: 8px;
  --radius-sm: 6px;
  --font-code: Consolas, "Courier New", monospace;
  background: var(--bg-page);
  color: var(--text-primary);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", "Helvetica Neue", Arial, sans-serif;
  font-size: calc(26 * var(--u));
  line-height: 1.6;
}

/* 宽屏锁尺：430px 宽的设计稿（≈ 大屏手机） */
@media (min-width: 480px) {
  page {
    --u: 0.5733333px;
    --W: 430px;
  }
}

view, text, scroll-view, button, input, textarea, picker, image {
  box-sizing: border-box;
}

/* ---------- 3. 系统深色 ---------- */
@media (prefers-color-scheme: dark) {
  :root {
    --bg-page: #121318;
    --bg-card: #1C1E26;
    --bg-subtle: #16181F;
    --border: #2A2D38;
    --border-strong: #3A3E4C;
    --divider: #262932;
    --text-primary: #E8EAEE;
    --text-secondary: #9CA0AB;
    --text-tertiary: #636877;
    --text-on-primary: #FFFFFF;
    --primary: #5A9AE6;
    --primary-hover: #7CB0F0;
    --primary-bg: #1E2A3A;
    --success: #5FBF8E;
    --success-bg: #172A22;
    --warning: #D9A05B;
    --warning-bg: #2A2318;
    --danger: #E87373;
    --danger-bg: #2C1E20;
    --code-bg: #16181F;
    --code-text: #DCE4F0;
    --code-border: #2A2D38;
    --shadow-card: none;
    --shadow-soft: none;
    --mask-bg: rgba(9, 10, 14, 0.72);
  }
  page {
    --bg-page: #121318;
    --bg-card: #1C1E26;
    --bg-subtle: #16181F;
    --border: #2A2D38;
    --border-strong: #3A3E4C;
    --divider: #262932;
    --text-primary: #E8EAEE;
    --text-secondary: #9CA0AB;
    --text-tertiary: #636877;
    --text-on-primary: #FFFFFF;
    --primary: #5A9AE6;
    --primary-hover: #7CB0F0;
    --primary-bg: #1E2A3A;
    --success: #5FBF8E;
    --success-bg: #172A22;
    --warning: #D9A05B;
    --warning-bg: #2A2318;
    --danger: #E87373;
    --danger-bg: #2C1E20;
    --code-bg: #16181F;
    --code-text: #DCE4F0;
    --code-border: #2A2D38;
    --shadow-card: none;
    --shadow-soft: none;
    --mask-bg: rgba(9, 10, 14, 0.72);
  }
}

/* ---------- 4. 手动深色（实际生效路径：类选择器） ---------- */
.theme-dark {
  --bg-page: #121318;
  --bg-card: #1C1E26;
  --bg-subtle: #16181F;
  --border: #2A2D38;
  --border-strong: #3A3E4C;
  --divider: #262932;
  --text-primary: #E8EAEE;
  --text-secondary: #9CA0AB;
  --text-tertiary: #636877;
  --text-on-primary: #FFFFFF;
  --primary: #5A9AE6;
  --primary-hover: #7CB0F0;
  --primary-bg: #1E2A3A;
  --success: #5FBF8E;
  --success-bg: #172A22;
  --warning: #D9A05B;
  --warning-bg: #2A2318;
  --danger: #E87373;
  --danger-bg: #2C1E20;
  --code-bg: #16181F;
  --code-text: #DCE4F0;
  --code-border: #2A2D38;
  --shadow-card: none;
  --shadow-soft: none;
  --mask-bg: rgba(9, 10, 14, 0.72);
}

/* 手动深色（属性选择器写法；部分内核支持，单独成块避免连累类选择器）
   质感令牌（glass/glow/ring/shadow-btn/primary-grad）也必须在此覆盖 ——
   否则只用 data-theme 而没有 theme-dark 类的元素会漏掉质感层。
   本块须与 .theme-dark 完全等价（check_theme_tokens.py 会校验两者对称）。 */
[data-theme="dark"] {
  --bg-page: #121318;
  --bg-card: #1C1E26;
  --bg-subtle: #16181F;
  --border: #2A2D38;
  --border-strong: #3A3E4C;
  --divider: #262932;
  --text-primary: #E8EAEE;
  --text-secondary: #9CA0AB;
  --text-tertiary: #636877;
  --text-on-primary: #FFFFFF;
  --primary: #5A9AE6;
  --primary-hover: #7CB0F0;
  --primary-bg: #1E2A3A;
  --success: #5FBF8E;
  --success-bg: #172A22;
  --warning: #D9A05B;
  --warning-bg: #2A2318;
  --danger: #E87373;
  --danger-bg: #2C1E20;
  --code-bg: #16181F;
  --code-text: #DCE4F0;
  --code-border: #2A2D38;
  --shadow-card: none;
  --shadow-soft: none;
  --mask-bg: rgba(9, 10, 14, 0.72);
  /* 质感层：与 .theme-dark 逐项一致 */
  --glass-bg: rgba(30, 33, 42, 0.68);
  --glass-bg-strong: rgba(34, 37, 48, 0.88);
  --glass-border: rgba(255, 255, 255, 0.10);
  --glass-sheen: rgba(255, 255, 255, 0.07);
  --glow-1: rgba(58, 110, 190, 0.22);
  --glow-2: rgba(96, 80, 170, 0.20);
  --glow-3: rgba(50, 140, 120, 0.18);
  --glow-clear: rgba(18, 19, 24, 0);
  --ring: rgba(90, 154, 230, 0.30);
  --shadow-glass: 0 12px 36px rgba(9, 10, 14, 0.46), 0 1px 2px rgba(9, 10, 14, 0.30);
  --shadow-btn: 0 8px 24px rgba(90, 154, 230, 0.26), 0 2px 6px rgba(9, 10, 14, 0.30);
  --primary-grad: linear-gradient(135deg, #7CB0F0 0%, #4A86D8 100%);
}

/* ---------- 5. 手动浅色（必须覆盖回浅色，优先级高于系统 media） ---------- */
.theme-light {
  --bg-page: #F7F8FA;
  --bg-card: #FFFFFF;
  --bg-subtle: #F3F5F7;
  --border: #EBEEF2;
  --border-strong: #D6DBE3;
  --divider: #EDF0F4;
  --text-primary: #1A1D24;
  --text-secondary: #5F6672;
  --text-tertiary: #9AA1AD;
  --text-on-primary: #FFFFFF;
  --primary: #3B7DD8;
  --primary-hover: #2F6BBF;
  --primary-bg: #EDF3FB;
  --success: #2E9E6B;
  --success-bg: #E9F6EF;
  --warning: #D98A34;
  --warning-bg: #FBF2E6;
  --danger: #D64545;
  --danger-bg: #FBEEEE;
  --code-bg: #F2F5F9;
  --code-text: #2F3A4A;
  --code-border: #DEE5EE;
  --shadow-card: 0 1px 3px rgba(26, 29, 36, 0.05);
  --shadow-soft: 0 1px 2px rgba(26, 29, 36, 0.06);
  --mask-bg: rgba(18, 20, 26, 0.55);
}

[data-theme="light"] {
  --bg-page: #F7F8FA;
  --bg-card: #FFFFFF;
  --bg-subtle: #F3F5F7;
  --border: #EBEEF2;
  --border-strong: #D6DBE3;
  --divider: #EDF0F4;
  --text-primary: #1A1D24;
  --text-secondary: #5F6672;
  --text-tertiary: #9AA1AD;
  --text-on-primary: #FFFFFF;
  --primary: #3B7DD8;
  --primary-hover: #2F6BBF;
  --primary-bg: #EDF3FB;
  --success: #2E9E6B;
  --success-bg: #E9F6EF;
  --warning: #D98A34;
  --warning-bg: #FBF2E6;
  --danger: #D64545;
  --danger-bg: #FBEEEE;
  --code-bg: #F2F5F9;
  --code-text: #2F3A4A;
  --code-border: #DEE5EE;
  --shadow-card: 0 1px 3px rgba(26, 29, 36, 0.05);
  --shadow-soft: 0 1px 2px rgba(26, 29, 36, 0.06);
  --mask-bg: rgba(18, 20, 26, 0.55);
  /* 质感层：与 .theme-light 逐项一致 */
  --glass-bg: rgba(255, 255, 255, 0.72);
  --glass-bg-strong: rgba(255, 255, 255, 0.9);
  --glass-border: rgba(255, 255, 255, 0.92);
  --glass-sheen: rgba(255, 255, 255, 0.7);
  --glow-1: rgba(91, 155, 235, 0.20);
  --glow-2: rgba(150, 125, 225, 0.16);
  --glow-3: rgba(90, 200, 175, 0.14);
  --glow-clear: rgba(255, 255, 255, 0);
  --ring: rgba(59, 125, 216, 0.26);
  --shadow-glass: 0 8px 32px rgba(31, 45, 80, 0.10), 0 1px 2px rgba(31, 45, 80, 0.06);
  --shadow-btn: 0 8px 22px rgba(59, 125, 216, 0.30), 0 2px 6px rgba(59, 125, 216, 0.18);
  --primary-grad: linear-gradient(135deg, #5A9AE6 0%, #3B7DD8 100%);
