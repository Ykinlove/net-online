.cmd { padding-bottom: calc(180 * var(--u)); }

.cmd-head {
  display: flex;
  align-items: flex-start;
  margin-bottom: calc(6 * var(--u));
}
.cmd-title-wrap { display: flex; flex-direction: column; }
.page-title { font-size: calc(36 * var(--u)); font-weight: 600; color: var(--text-primary); }
.cmd-sub { font-size: calc(21 * var(--u)); color: var(--text-secondary); margin-top: calc(4 * var(--u)); }
.cmd-actions {
  margin-left: auto;
  display: flex;
  align-items: center;
  gap: calc(12 * var(--u));
}
.icon-btn {
  width: calc(62 * var(--u));
  height: calc(62 * var(--u));
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: calc(30 * var(--u));
  color: var(--text-secondary);
  background: var(--glass-bg);
  -webkit-backdrop-filter: blur(18px) saturate(160%);
  backdrop-filter: blur(18px) saturate(160%);
  border: 1px solid var(--glass-border);
  border-radius: var(--radius-sm);
}
.icon-btn-hover { background: var(--bg-subtle); }

.cmd-diag {
  display: block;
  font-size: calc(20 * var(--u));
  color: var(--text-tertiary);
  margin-bottom: calc(14 * var(--u));
  line-height: 1.5;
}
.cmd-diag.is-err { color: var(--danger); }

/* 分类标签：普通 flex + 允许换行，保证全部设备按钮始终完整可见，不再被滚动容器裁掉 */
.dev-bar {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: calc(12 * var(--u));
  margin-bottom: calc(14 * var(--u));
}
.dev-bar .seg-item {
  flex: none;
  gap: calc(6 * var(--u));
  height: calc(60 * var(--u));
}
.dev-num {
  margin-left: calc(6 * var(--u));
  font-size: calc(19 * var(--u));
  color: var(--primary);
}
.dev-bar .seg-item.on .dev-num { color: var(--text-on-primary); }

/* 命令卡：白底细边 + 左侧设备语义色竖条（全局 .cmd-card / .vendor-*） */
.cmd-card {
  padding: calc(18 * var(--u)) calc(20 * var(--u));
  margin-bottom: calc(16 * var(--u));
}
/* 三层阅读结构：设备标签 → 命令标题 → 命令代码块，
   不再把设备和标题挤在同一行（长标题会被截断、层级也分不清） */
.cmd-card-top {
  display: flex;
  align-items: center;
  margin-bottom: calc(12 * var(--u));
}
.cmd-dev { flex: none; font-size: calc(19 * var(--u)); font-weight: 600; }
.cmd-name {
  display: block;
  font-size: calc(28 * var(--u));
  font-weight: 600;
  line-height: 1.4;
  color: var(--text-primary);
  margin-bottom: calc(12 * var(--u));
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
/* 列表命令预览：浅色等宽代码块 */
.cmd-code {
  display: block;
  font-family: var(--font-code);
  font-size: calc(23 * var(--u));
  line-height: 1.55;
  color: var(--code-text);
  background: var(--code-bg);
  border: 1px solid var(--code-border);
  border-radius: var(--radius-sm);
  padding: calc(13 * var(--u)) calc(15 * var(--u));
  max-height: calc(128 * var(--u));
  overflow: hidden;
  white-space: pre-wrap;
  word-break: break-all;
}

/* 详情代码块：等宽、横向滚动、右上角固定复制按钮 */
.cmd-codeblock {
  overflow: visible;
  padding-top: calc(52 * var(--u));
  margin-bottom: calc(14 * var(--u));
}
.cmd-codeblock .code-scroll { width: 100%; }
.cmd-codeblock .dt-code {
  display: inline-block;
  font-family: var(--font-code);
  font-size: calc(23 * var(--u));
  line-height: 1.7;
  color: var(--code-text);
  white-space: pre;
}

/* 详情共用 */
.dt-meta { display: flex; gap: calc(10 * var(--u)); margin-bottom: calc(16 * var(--u)); flex-wrap: wrap; }
.dt-code-wrap {
  background: var(--code-bg);
  border: 1px solid var(--code-border);
  border-radius: var(--radius-md);
  padding: calc(16 * var(--u)) calc(18 * var(--u));
  margin-bottom: calc(14 * var(--u));
  box-sizing: border-box;
}
.dt-desc { display: block; font-size: calc(22 * var(--u)); color: var(--text-secondary); margin-bottom: calc(16 * var(--u)); }
.dt-actions { display: flex; gap: calc(12 * var(--u)); }
.dt-actions .btn { flex: 1; }

/* 编辑态底部：删除 + 保存 两列 */
.form-actions {
  display: flex;
  gap: calc(12 * var(--u));
  margin-top: calc(26 * var(--u));
}
.form-actions .btn { flex: 1; }

/* 选择器框（projects 共用） */
.picker-box {
  display: flex;
  align-items: center;
  height: calc(92 * var(--u));
  padding: 0 calc(24 * var(--u));
  background: var(--glass-bg);
  -webkit-backdrop-filter: blur(18px) saturate(160%);
  backdrop-filter: blur(18px) saturate(160%);
  border: 1px solid var(--glass-border);
  border-radius: var(--radius-sm);
  font-size: calc(29 * var(--u));
  color: var(--text-primary);
}
.picker-caret { margin-left: auto; color: var(--text-tertiary); font-size: calc(22 * var(--u)); }

/* v6：复制勾；设备标签按门类上色（复用已有语义色，深浅主题自动跟随） */
.code-copy .tick { margin: calc(4 * var(--u)) auto 0; }
.cmd-dev.dev-windows { color: var(--primary); background: var(--primary-bg); border-color: var(--primary); }
.cmd-dev.dev-switch  { color: var(--success); background: var(--success-bg); border-color: var(--success); }
.cmd-dev.dev-router  { color: var(--warning); background: var(--warning-bg); border-color: var(--warning); }
.cmd-dev.dev-other   { color: var(--text-secondary); background: var(--bg-subtle); border-color: var(--border); }
