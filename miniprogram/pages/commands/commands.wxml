<view class="page cmd theme-{{theme}}" data-theme="{{theme}}" style="--dur:{{dur || 0.28}}s">

  <offline-bar />

  <view class="cmd-head">
    <view class="cmd-title-wrap">
      <text class="page-title">命令手记</text>
      <text class="cmd-sub roll-num">共 {{total}} 条 · {{filterText}}</text>
    </view>
    <view class="cmd-actions">
      <view class="icon-btn" bindtap="refresh" hover-class="icon-btn-hover">↻</view>
      <view class="btn btn-sm btn-primary" bindtap="openAdd">+ 记命令</view>
    </view>
  </view>

  <text class="cmd-diag {{diagErr ? 'is-err' : ''}}">{{diag}}</text>

  <view class="dev-bar">
    <view
      wx:for="{{devices}}"
      wx:key="*this"
      class="seg-item {{filter === item ? 'on' : ''}}"
      data-v="{{item}}"
      bindtap="setFilter"
    >
      <text>{{item}}</text>
      <text wx:if="{{devCount[item]}}" class="dev-num">{{devCount[item]}}</text>
    </view>
  </view>

  <view wx:if="{{!shown.length}}" class="empty">{{total ? '这个设备下还没有命令' : '还没有命令'}}</view>

  <view
    wx:for="{{shown}}"
    wx:key="_key"
    class="cmd-card {{item.vendorClass}}"
    data-idx="{{index}}"
    bindtap="openDetail"
  >
    <view class="cmd-card-top">
      <text class="cmd-dev tag-outline dev-{{item.devClass}}">{{item.device}}</text>
    </view>
    <text class="cmd-name">{{item.title}}</text>
    <text class="cmd-code">{{item.preview}}</text>
  </view>

  <!-- 详情 -->
  <view wx:if="{{detail}}" class="mask" bindtap="closeDetail">
    <view class="sheet {{drawerDragging ? 'dragging' : ''}}" style="{{drawerStyle}}" catchtap="noop">
      <view class="drawer-handle" bindtouchstart="onDrawerStart" bindtouchmove="onDrawerMove" bindtouchend="onDrawerEnd"></view>
      <view class="sheet-head">
        <text class="sheet-title">{{detail.title}}</text>
        <text class="sheet-close" bindtap="closeDetail">×</text>
      </view>
      <view class="dt-meta">
        <text class="chip">{{detail.device}}</text>
        <text wx:if="{{detail.skill}}" class="chip">{{detail.skill}}</text>
      </view>
      <view class="code-block cmd-codeblock">
        <view class="code-copy {{codeCopied ? 'done' : ''}}" catchtap="onCopyCode">
          <text wx:if="{{!codeCopied}}">复制</text>
          <view wx:else class="tick"><view class="tick-a"></view><view class="tick-b"></view></view>
        </view>
        <scroll-view class="code-scroll" scroll-x enable-flex>
          <text class="dt-code">{{detail.content}}</text>
        </scroll-view>
      </view>
      <text wx:if="{{detail.desc}}" class="dt-desc">说明：{{detail.desc}}</text>

      <view class="dt-actions">
        <view class="btn btn-ghost" bindtap="openEdit">编辑</view>
        <view class="btn btn-primary" bindtap="copyCmd">复制命令</view>
      </view>
    </view>
  </view>

  <!-- 新增 / 编辑 -->
  <view wx:if="{{formOpen}}" class="mask" bindtap="closeForm">
    <view class="sheet {{drawerDragging ? 'dragging' : ''}}" style="{{drawerStyle}}" catchtap="noop">
      <view class="drawer-handle" bindtouchstart="onDrawerStart" bindtouchmove="onDrawerMove" bindtouchend="onDrawerEnd"></view>
      <view class="sheet-head">
        <text class="sheet-title">{{editingId ? '编辑命令' : '记一条命令'}}</text>
        <text class="sheet-close" bindtap="closeForm">×</text>
      </view>

      <view class="field">
        <text class="field-label">设备类型</text>
        <view class="seg">
          <view
            wx:for="{{devices2}}"
            wx:key="*this"
            class="seg-item {{form.device === item ? 'on' : ''}}"
            data-v="{{item}}"
            bindtap="pickDevice"
          >{{item}}</view>
        </view>
      </view>

      <view class="field">
        <text class="field-label">标题 <text class="req">*</text></text>
        <input class="input {{focusKey === 'title' ? 'input-focus' : ''}}" value="{{form.title}}" maxlength="40" placeholder="比如：查看端口隔离组" placeholder-class="input-placeholder" data-k="title" bindinput="onFormInput" bindfocus="onFieldFocus" bindblur="onFieldBlur" />
      </view>

      <view class="field">
        <text class="field-label">命令内容 <text class="req">*</text></text>
        <textarea class="textarea mono {{focusKey === 'content' ? 'input-focus' : ''}}" value="{{form.content}}" placeholder="原样粘贴命令，支持多行" placeholder-class="input-placeholder" data-k="content" bindinput="onFormInput" bindfocus="onFieldFocus" bindblur="onFieldBlur" auto-height />
      </view>

      <view class="field">
        <text class="field-label">说明 / 用途</text>
        <input class="input {{focusKey === 'desc' ? 'input-focus' : ''}}" value="{{form.desc}}" maxlength="60" placeholder="这条命令干什么用的" placeholder-class="input-placeholder" data-k="desc" bindinput="onFormInput" bindfocus="onFieldFocus" bindblur="onFieldBlur" />
      </view>

      <view class="field">
        <text class="field-label">标签（逗号分隔）</text>
        <input class="input {{focusKey === 'tags' ? 'input-focus' : ''}}" value="{{form.tags}}" maxlength="60" placeholder="比如：排障,VLAN" placeholder-class="input-placeholder" data-k="tags" bindinput="onFormInput" bindfocus="onFieldFocus" bindblur="onFieldBlur" />
      </view>

      <view wx:if="{{editingId}}" class="form-actions">
        <view class="btn btn-danger" bindtap="deleteFromForm">删除</view>
        <view class="btn btn-primary" bindtap="saveForm">保存</view>
      </view>
      <view wx:else class="btn btn-primary btn-block" bindtap="saveForm">保存</view>
    </view>
  </view>
</view>
