.mine { padding-bottom: calc(40 * var(--u)); }

/* 资料卡：淡蓝渐变 + 圆形头像徽章 */
.char-card {
  display: flex;
  align-items: center;
  gap: calc(20 * var(--u));
  padding: calc(26 * var(--u)) calc(24 * var(--u));
  margin-bottom: calc(20 * var(--u));
}
.char-avatar {
  flex: none;
  width: calc(120 * var(--u));
  height: calc(120 * var(--u));
}
.char-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: calc(6 * var(--u));
}
.char-name {
  font-size: calc(34 * var(--u));
  font-weight: 600;
  color: var(--text-primary);
}
.char-desc { font-size: calc(22 * var(--u)); color: var(--text-secondary); }
.char-chips { display: flex; flex-wrap: wrap; gap: calc(8 * var(--u)); margin-top: calc(4 * var(--u)); }
.chip-mini {
  display: inline-flex;
  align-items: center;
  height: calc(32 * var(--u));
  padding: 0 calc(12 * var(--u));
  font-size: calc(19 * var(--u));
  font-weight: 600;
  color: var(--primary);
  background: var(--primary-bg);
  border: 1px solid var(--glass-border);
  border-radius: var(--radius-sm);
}
.kw-card { padding: calc(14 * var(--u)) calc(20 * var(--u)) calc(16 * var(--u)); }
.kw-line { display: flex; align-items: flex-start; gap: calc(14 * var(--u)); padding: calc(9 * var(--u)) 0; }
.kw-line + .kw-line {
  padding-top: calc(15 * var(--u));
  border-top: 1px solid var(--divider);
}
.kw-label { flex: none; font-size: calc(22 * var(--u)); font-weight: 600; color: var(--text-tertiary); width: calc(52 * var(--u)); }
.kw-list { flex: 1; display: flex; flex-wrap: wrap; gap: calc(10 * var(--u)); }

/* 功能列表：去外框，改底部分割线（.list-item 提供） */
.menu { margin-bottom: calc(24 * var(--u)); }
.menu-row {
  display: flex;
  align-items: center;
  gap: calc(14 * var(--u));
}
.menu-row-hover { background: var(--bg-subtle); }
.menu-txt { font-size: calc(27 * var(--u)); font-weight: 600; color: var(--text-primary); }
.menu-sub { margin-left: auto; font-size: calc(21 * var(--u)); color: var(--text-tertiary); }
.menu-badge {
  margin-left: auto;
  font-size: calc(19 * var(--u));
  font-weight: 600;
  color: var(--text-on-primary);
  background: var(--primary);
  border-radius: calc(14 * var(--u));
  padding: calc(1 * var(--u)) calc(12 * var(--u));
}
.menu-badge + .menu-arrow { margin-left: calc(10 * var(--u)); }
.menu-arrow { font-size: calc(30 * var(--u)); color: var(--text-tertiary); margin-left: auto; }
.menu-sub + .menu-arrow { margin-left: calc(10 * var(--u)); }

.mine-foot {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: calc(6 * var(--u));
  padding: calc(20 * var(--u)) 0 calc(10 * var(--u));
}
.foot-brand { font-size: calc(22 * var(--u)); font-weight: 600; color: var(--text-tertiary); }
.foot-line { font-size: calc(20 * var(--u)); color: var(--text-tertiary); }
.foot-ver { font-size: calc(20 * var(--u)); color: var(--text-tertiary); }

/* 搜不到的说法 */
.miss-list {
  display: flex;
  flex-wrap: wrap;
  gap: calc(10 * var(--u));
  margin-top: calc(4 * var(--u));
}
.miss-chip {
  font-size: calc(20 * var(--u));
  color: var(--warning);
  background: var(--warning-bg);
  border: 1px solid var(--glass-border);
  border-radius: var(--radius-sm);
  padding: calc(5 * var(--u)) calc(14 * var(--u));
}
.miss-tip {
  display: block;
  margin-top: calc(12 * var(--u));
  font-size: calc(19 * var(--u));
  color: var(--text-tertiary);
}

/* ---------- v4：资料卡插画回归（像素场景 + 玻璃信息层） ---------- */
.char-card { position: relative; overflow: hidden; }
.char-scene { position: absolute; left: 0; top: 0; width: 100%; height: 100%; }
.char-scene-dim {
  position: absolute; left: 0; top: 0; width: 100%; height: 100%;
  background: var(--bg-page);
  opacity: 0.20;
  pointer-events: none;
}
.theme-dark .char-scene-dim { opacity: 0.52; }
.char-scene-veil {
  position: absolute; left: 0; top: 0; width: 100%; height: 100%;
  background: linear-gradient(90deg, var(--glass-bg-strong) 0%, var(--glass-bg) 46%, var(--glow-clear) 100%);
  -webkit-backdrop-filter: blur(8px) saturate(130%);
  backdrop-filter: blur(8px) saturate(130%);
  pointer-events: none;
}
.char-avatar, .char-info { position: relative; z-index: 1; }
.char-avatar { background: var(--primary-bg); }
.card-title-row .icon-badge { margin-right: calc(12 * var(--u)); }
.inset-row .menu-arrow { flex: none; }
