@import "../commands/commands.wxss";

.pj { padding-bottom: calc(180 * var(--u)); }

.pj-card {
  background: var(--glass-bg);
  -webkit-backdrop-filter: blur(18px) saturate(160%);
  backdrop-filter: blur(18px) saturate(160%);
  border: 1px solid var(--glass-border);
  border-radius: var(--radius-md);
  box-shadow: inset 0 1px 0 var(--glass-sheen), var(--shadow-glass);
  padding: calc(18 * var(--u)) calc(20 * var(--u));
  margin-bottom: calc(16 * var(--u));
}
.pj-top {
  display: flex;
  align-items: center;
  gap: calc(10 * var(--u));
  margin-bottom: calc(10 * var(--u));
}
/* 状态标签由全局 .tag-outline / .tag-done / .tag-doing 控制配色，这里只管布局 */
.pj-status { flex: none; }
/* 状态 / 日期一行，项目名独占一行：项目名称是主信息，不能被状态标签挤掉 */
.pj-name {
  display: block;
  font-size: calc(28 * var(--u));
  font-weight: 600;
  line-height: 1.4;
  color: var(--text-primary);
  margin-bottom: calc(10 * var(--u));
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.pj-date {
  flex: none;
  margin-left: auto;
  font-size: calc(20 * var(--u));
  color: var(--text-tertiary);
}
.pj-role { display: block; font-size: calc(21 * var(--u)); color: var(--text-tertiary); margin-bottom: calc(8 * var(--u)); }
.pj-tags { display: flex; flex-wrap: wrap; gap: calc(8 * var(--u)); margin-top: calc(12 * var(--u)); }

/* 详情正文 */
.dt-body {
  display: block;
  font-size: calc(24 * var(--u));
  line-height: 1.7;
  color: var(--text-primary);
  white-space: pre-wrap;
  word-break: break-all;
}

.picker-box .ph { color: var(--text-tertiary); }
.picker-clear {
  display: inline-block;
  margin-top: calc(10 * var(--u));
  font-size: calc(21 * var(--u));
  color: var(--primary);
  text-decoration: underline;
}

/* ---------- v4：图标底板与统计卡间距 ---------- */
.cmd-head .icon-badge { margin-right: calc(4 * var(--u)); }
/* .pj-top .icon-badge 的 flex:none 由 app.wxss 统一提供，勿在本页重复定义 */
.sheet-head .icon-badge { margin-right: calc(12 * var(--u)); }
.card-title-row .icon-badge { margin-right: calc(12 * var(--u)); }
.pj-list { margin-bottom: calc(4 * var(--u)); }

/* ---------- 卡片与标签语义配色 ----------
   只给「重要标签」和卡片左侧竖条上色，正文仍保持黑灰，
   这样有辨识度但不会回到之前那种满屏花色的状态。
   全部复用已有语义色 token，深浅主题自动跟随。 */
.pj-card.pj-tone-done  { border-left: calc(6 * var(--u)) solid var(--success); }
.pj-card.pj-tone-doing { border-left: calc(6 * var(--u)) solid var(--primary); }
.pj-card.pj-tone-pause { border-left: calc(6 * var(--u)) solid var(--warning); }

.pj-status.tag-done    { background: var(--success-bg); }
.pj-status.tag-doing   { background: var(--primary-bg); }
.pj-status.tag-warning { background: var(--warning-bg); }

/* 项目标签按位置循环 4 组淡色，重要标签不再一律灰 */
.pj-tags .tg-0 { color: var(--primary); background: var(--primary-bg); border-color: var(--primary); }
.pj-tags .tg-1 { color: var(--success); background: var(--success-bg); border-color: var(--success); }
.pj-tags .tg-2 { color: var(--warning); background: var(--warning-bg); border-color: var(--warning); }
.pj-tags .tg-3 { color: var(--danger);  background: var(--danger-bg);  border-color: var(--danger); }

.pj-role { color: var(--text-secondary); }
