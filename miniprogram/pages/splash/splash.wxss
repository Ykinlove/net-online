.splash {
  width: 100%;
  height: 100vh;
  position: relative;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #5fb4f2;
}
.splash-bg {
  position: absolute;
  left: 0; top: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
}
.splash-mask {
  position: absolute;
  left: 0; top: 0; right: 0; bottom: 0;
  background: linear-gradient(180deg, rgba(20, 45, 70, 0.15) 0%, rgba(20, 45, 70, 0.5) 100%);
  z-index: 1;
}
.splash-content {
  position: relative;
  z-index: 2;
  width: 100%;
  padding: 0 calc(60 * var(--u));
  display: flex;
  flex-direction: column;
  align-items: center;
}
/* logo 尺寸与 H5 启动页保持一致：H5 里 logo 宽 412px / 按钮 385px（logo 比按钮宽），
   画布 750rpx 下等比换算 → 600×400rpx（600:400 = 图片原始宽高比，aspectFit 满格不变形）。
   之前是 520×200rpx 盒子配 aspectFit，实际只渲染 300rpx 宽——比下面 520rpx 的按钮窄一半，
   层级反过来才显得「图片变小、画面不协调」。 */
.splash-logo {
  width: calc(600 * var(--u));
  height: calc(400 * var(--u));
  margin-bottom: calc(70 * var(--u));
  filter: drop-shadow(0 calc(10 * var(--u)) calc(20 * var(--u)) rgba(0, 0, 0, 0.35));
}
.splash-cta {
  width: 100%;
  max-width: calc(520 * var(--u));
  padding: calc(30 * var(--u)) 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #ffd86b;
  border: calc(6 * var(--u)) solid #2c3e50;
  border-radius: calc(12 * var(--u));
  box-shadow: 0 calc(10 * var(--u)) 0 rgba(0, 0, 0, 0.35);
}
.splash-cta-hover {
  transform: translateY(calc(6 * var(--u)));
  box-shadow: 0 calc(4 * var(--u)) 0 rgba(0, 0, 0, 0.35);
}
.splash-cta-text {
  font-size: calc(36 * var(--u));
  font-weight: 800;
  color: #2c3e50;
  letter-spacing: calc(2 * var(--u));
}
.splash-tagline {
  margin-top: calc(34 * var(--u));
  font-size: calc(24 * var(--u));
  color: #f2f8ff;
  text-shadow: 0 calc(2 * var(--u)) calc(6 * var(--u)) rgba(0, 0, 0, 0.5);
}
.splash-foot {
  position: absolute;
  left: 0; right: 0;
  bottom: calc(calc(40 * var(--u)) + env(safe-area-inset-bottom));
  z-index: 2;
  text-align: center;
  font-size: calc(21 * var(--u));
  color: rgba(255, 255, 255, 0.85);
  padding: 0 calc(40 * var(--u));
}
