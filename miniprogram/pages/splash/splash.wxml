<view class="splash">
  <image class="splash-bg" src="/images/ui/splash-bg.jpg" mode="aspectFill"></image>
  <view class="splash-mask"></view>

  <view class="splash-content">
    <image class="splash-logo" src="/images/ui/logo.png" mode="aspectFit"></image>

    <view class="splash-cta" bindtap="enter" hover-class="splash-cta-hover">
      <text class="splash-cta-text">🌐 点击进入</text>
    </view>

    <text class="splash-tagline">记录每一条命令，攒成你的网络手感</text>
  </view>

  <view class="splash-foot">
    <text wx:if="{{syncing}}">正在连接云端…</text>
    <text wx:elif="{{syncHint}}">{{syncHint}}</text>
  </view>
</view>
