{
  "pages": [
    "pages/splash/splash",
    "pages/home/home",
    "pages/commands/commands",
    "pages/projects/projects",
    "pages/mine/mine"
  ],
  "window": {
    "backgroundColor": "@bgColor",
    "backgroundTextStyle": "@backgroundTextStyle",
    "navigationBarBackgroundColor": "@navBgColor",
    "navigationBarTitleText": "Net 操作命令速记",
    "navigationBarTextStyle": "@navTxtStyle"
  },
  "tabBar": {
    "color": "@tabFontColor",
    "selectedColor": "@tabSelectedColor",
    "backgroundColor": "@tabBgColor",
    "borderStyle": "@tabBorderStyle",
    "list": [
      {
        "pagePath": "pages/home/home",
        "text": "首页",
        "iconPath": "@tabIconHome",
        "selectedIconPath": "@tabIconHomeOn"
      },
      {
        "pagePath": "pages/commands/commands",
        "text": "命令",
        "iconPath": "@tabIconCommands",
        "selectedIconPath": "@tabIconCommandsOn"
      },
      {
        "pagePath": "pages/projects/projects",
        "text": "项目",
        "iconPath": "@tabIconProjects",
        "selectedIconPath": "@tabIconProjectsOn"
      },
      {
        "pagePath": "pages/mine/mine",
        "text": "我的",
        "iconPath": "@tabIconMine",
        "selectedIconPath": "@tabIconMineOn"
      }
    ]
  },
  "style": "v2",
  "sitemapLocation": "sitemap.json",
  "lazyCodeLoading": "requiredComponents",
  "darkmode": true,
  "themeLocation": "theme.json",
  "subPackages": [
    {
      "root": "subpkg-tool",
      "name": "tool",
      "pages": [
        "pages/search/search",
        "pages/browse/browse",
        "pages/fav/fav",
        "pages/miss/miss",
        "pages/templates/templates",
        "pages/admin/admin",
        "pages/contribute/contribute"
      ]
    },
    {
      "root": "subpkg-mine",
      "name": "mine",
      "pages": [
        "pages/mine-skill/mine-skill",
        "pages/mine-archive/mine-archive",
        "pages/mine-settings/mine-settings",
        "pages/mine-help/mine-help",
        "pages/onboard/onboard",
        "pages/chargen/chargen",
        "pages/maker/maker"
      ]
    }
  ],
  "preloadRule": {
    "pages/splash/splash": {
      "network": "all",
      "packages": [
        "mine"
      ]
    },
    "pages/home/home": {
      "network": "all",
      "packages": [
        "tool",
        "mine"
      ]
    },
    "pages/mine/mine": {
      "network": "all",
      "packages": [
        "tool",
        "mine"
      ]
    }
  }
}
