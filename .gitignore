# ---- 构建产物 / 一次性脚本产物 ----
miniprogram-tools/chargen_new/
miniprogram-tools/char_backup_old/
miniprogram-tools/images_removed/
miniprogram-tools/images_backup_orig/
miniprogram-tools/img_backup_opt/
miniprogram-tools/_backup_split/
miniprogram-tools/data_snapshot_before.json

# getCmdLib 云函数的内置整库快照（1.58MB）。
# 由 miniprogram-tools/build_cmdlib.js 从 cmdbook.js 生成，部署前跑一次即可。
# 不入库：避免每次改命令库都产生 1.6MB 巨型 diff，也避免它与 cmdbook.js 漂移。
cloudfunctions/getCmdLib/cmdlib.json

# 根目录的 clone_work（另一个小程序的完整副本，14MB）
clone_work/

# chargen_preview：脚本与配置留档，生成的图片原料不留
# （最终采用的图已经在 miniprogram/images/preset/char）
chargen_preview/*.png
chargen_preview/**/*.png
chargen_preview/raw/
chargen_preview/picked/

# ---- 临时对比图 / 中间产物 ----
miniprogram-tools/cmp_new_vs_old.png
miniprogram-tools/preview_cmp.png
miniprogram-tools/chars_sheet.png
miniprogram-tools/chars_on_bg.png
miniprogram-tools/character_02_before.png
miniprogram-tools/_backup_cmdbook_before_rank.js
miniprogram-tools/app.wxss.bak

# ---- 根目录的参考网页（3MB+ 单文件，不进仓库）----
reference.html
published_check.html

# ---- 系统 ----
.DS_Store
Thumbs.db
*.log
node_modules/

# 端侧自动化验证的临时依赖（miniprogram-automator，约 20MB）
miniprogram-tools/.tmp-verify/

# 开发者工具自动生成的本机私有配置（含本机路径，不应入库）
project.private.config.json

# ---- 本地私密配置（含 openid 白名单 / 管理口令 / 凭据）----
# 仓库里只留 cloudbaserc.local.example.json 模板
cloudbaserc.local.json

# 一次性 docx 导入中间产物（含真实凭据，且无人引用）
docx_import/

# 一键上传脚本记录的本地版本号
miniprogram-tools/.last_upload_version

# WorkBuddy 工具自动生成的目录（自动化记忆等），不属于源码
.workbuddy/
